---
import { Image } from "astro:assets";

import ModelCard from "../components/ModelCard.astro";
import Base from "../layouts/Base.astro";
import { siteData } from "../lib/data";
import { localImage } from "../lib/images";
import {
  byCrungusness,
  byYear,
  clipCount,
  failedModels,
  generatedModels,
  timelineSample,
} from "../lib/models";
import { path } from "../lib/paths";

const models = generatedModels(siteData, "image");
const failed = failedModels(siteData, "image");
const soundModels = generatedModels(siteData, "audio");
const clipTotal = soundModels.reduce((n, m) => n + clipCount(m), 0);
const strip = timelineSample(models);
const years = byYear(models);
const scored = byCrungusness(models);
const imageTotal = models.reduce(
  (n, m) => n + m.prompts.reduce((k, p) => k + p.images.length, 0),
  0,
);
---

<Base
  title="Crungus Amongus — cryptid mining in latent space"
  description="An interactive archive comparing images and sounds generated by AI models from prompts containing crungus."
>
  <section class="hero">
    <h1>Cryptid mining in latent space</h1>
    <p class="lede">
      “Crungus” may sound familiar, like something from a fairy tale or half-forgotten children's movie,
      but the word was originally meaningless by design. It was coined in June 2022 by Guy Kelly,
      who found that entering “crungus” into the DALL·E mini image generator produced reliably monstrous results:
      some kind of ogrish creature, clawed, horned and hairy, like an orc from <em>The Lord of the Rings</em>.
    </p>
    <p class="lede">
      Kelly's experiment was widely replicated, and the crungus became famous as the first cryptid of latent space.
      Today, the term continues to generate monstrous imagery across AI models. For this project, we had
      {models.length} different models on Replicate produce 100 different images of the crungus for each of the prompts
      “crungus” and “a picture of a crungus”, without any style instructions or fixed seeds.
    </p>
    <p class="lede">
      The resulting menagerie reflects the many and varied shades of modern monstrousness, spanning the medieval and the
      alien, the creepy and the kawaii, the malevolent and the misunderstood.
    </p>
    <p class="lede">
      Browse {imageTotal.toLocaleString("en-AU")} images from {models.length} models,
      explore the <a href={path("/atlas/")}>atlas</a>, or use the <a href={path("/eigen/")}>eigencrungi sliders</a> to examine variation.
      <a href={path("/about/")}>About the research and collection method</a>.
    </p>
    <p>
      Years identify model releases; all outputs were generated for this project.
      The strip below selects one image per release year by its average similarity to the others in that group.
    </p>
    {
      strip.length > 1 && (
        <ol class="filmstrip" aria-label="representative images grouped by model release year">
          {strip.map((sample) => {
            const image = localImage(sample.key);
            return (
              <li>
                <a href={path(`/model/${sample.model.slug}/`)}>
                  {image && (
                    <Image
                      src={image}
                      alt={`representative output from a model released in ${sample.year}, by ${sample.model.owner}/${sample.model.name}`}
                      format="avif"
                      widths={[160, 320]}
                      sizes="160px"
                    />
                  )}
                  <span class="mono muted">{sample.year}</span>
                </a>
              </li>
            );
          })}
        </ol>
      )
    }
  </section>

  <section aria-labelledby="archive-heading">
    <div class="archive-head">
      <h2 id="archive-heading">The archive</h2>
      <p class="mono sort" hidden>
        <span class="muted">order by</span>
        <button id="sort-year" aria-pressed="true" type="button">year</button>
        <button id="sort-score" aria-pressed="false" type="button">consistency</button>
      </p>
    </div>

    <div id="by-year">
      {
        years.map(([year, group]) => (
          <section class="year" aria-label={`models from ${year}`}>
            <h3 class="mono muted">{year}</h3>
            <div class="grid">
              {group.map((model) => (
                <ModelCard model={model} />
              ))}
            </div>
          </section>
        ))
      }
    </div>

    <div id="by-score" hidden>
      <div class="grid">
        {scored.map((model) => <ModelCard model={model} />)}
      </div>
    </div>
  </section>

  {
    clipTotal > 0 && (
      <section class="listen" aria-labelledby="listen-heading">
        <h2 id="listen-heading">The sound of crungus</h2>
        <p>
          The audio collection uses “crungus” and “the sound of a crungus”: {clipTotal} clips from{" "}
          {soundModels.length} models, in the{" "}
          <a href={path("/sound/")}>sound archive</a>, or shuffled end to end on{" "}
          <a href={path("/mosaic/?radio")}>crungus radio</a>.
        </p>
      </section>
    )
  }

  <section class="listen" aria-labelledby="eigen-heading">
    <h2 id="eigen-heading">The eigencrungi</h2>
    <p>
      Explore variation in the archive through pixel and CLIP feature sliders:{" "}
      <a href={path("/eigen/")}>the eigencrungi</a>.
    </p>
  </section>

  {
    failed.length > 0 && (
      <section class="failed" aria-labelledby="failed-heading">
        <h2 id="failed-heading">Did not answer</h2>
        <p class="muted">
          These models were attempted without producing an image. Availability, input requirements and provider restrictions can prevent generation.
        </p>
        <ul class="mono">
          {failed.map((model) => (
            <li>
              <a href={model.replicate_url}>
                {model.owner}/{model.name}
              </a>
              <span class="muted"> — {model.status}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>

<script>
  // progressive enhancement: the sort toggle only appears when JS runs
  const controls = document.querySelector<HTMLElement>(".sort");
  const byYearEl = document.getElementById("by-year");
  const byScoreEl = document.getElementById("by-score");
  const yearBtn = document.getElementById("sort-year");
  const scoreBtn = document.getElementById("sort-score");

  if (controls && byYearEl && byScoreEl && yearBtn && scoreBtn) {
    controls.hidden = false;
    const select = (score: boolean) => {
      byYearEl.hidden = score;
      byScoreEl.hidden = !score;
      yearBtn.setAttribute("aria-pressed", String(!score));
      scoreBtn.setAttribute("aria-pressed", String(score));
    };
    yearBtn.addEventListener("click", () => select(false));
    scoreBtn.addEventListener("click", () => select(true));
  }
</script>

<style>
  .hero {
    padding-block: 2.5rem 3rem;
  }

  h1 {
    font-size: clamp(2.2rem, 6vw, 3.6rem);
    margin: 0 0 1rem;
  }

  .lede {
    max-width: 46rem;
    font-size: 1.1rem;
    margin: 0 0 2.25rem;
  }

  .filmstrip {
    list-style: none;
    display: flex;
    gap: 0.5rem;
    padding: 0;
    margin: 0;
    overflow-x: auto;
  }

  .filmstrip li {
    flex: 0 0 auto;
  }

  .filmstrip a {
    display: block;
    text-decoration: none;
  }

  .filmstrip img {
    display: block;
    width: clamp(96px, 14vw, 160px);
    aspect-ratio: 1;
    object-fit: cover;
    background: var(--surface);
  }

  .filmstrip span {
    display: block;
    padding-top: 0.3rem;
  }

  .filmstrip a:hover span {
    color: var(--accent-bright);
  }

  .archive-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  h2 {
    font-size: 1.6rem;
    margin: 0 0 0.75rem;
  }

  .sort button {
    background: none;
    border: 1px solid var(--line);
    color: var(--muted);
    font: inherit;
    padding: 0.2rem 0.7rem;
    cursor: pointer;
  }

  .sort button[aria-pressed="true"] {
    color: var(--ground);
    background: var(--accent);
    border-color: var(--accent);
  }

  .year h3 {
    font-size: 0.9rem;
    font-weight: 500;
    border-block-end: 1px solid var(--line);
    padding-block-end: 0.4rem;
    margin: 2rem 0 1rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(170px, 44vw), 1fr));
    gap: 1.25rem 1rem;
  }

  .listen,
  .failed {
    margin-block-start: 3.5rem;
  }

  .listen p {
    max-width: 46rem;
    margin: 0;
  }

  .failed ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.35rem;
  }
</style>
