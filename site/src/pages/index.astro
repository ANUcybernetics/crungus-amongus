---
import { Image } from "astro:assets";

import ModelCard from "../components/ModelCard.astro";
import Base from "../layouts/Base.astro";
import { siteData } from "../lib/data";
import { localImage } from "../lib/images";
import {
  byCrungusness,
  byYear,
  coverImage,
  failedModels,
  generatedModels,
  releaseYear,
  timelineSample,
} from "../lib/models";

const base = import.meta.env.BASE_URL;
const models = generatedModels(siteData);
const failed = failedModels(siteData);
const strip = timelineSample(models);
const years = byYear(models);
const scored = byCrungusness(models);
const imageTotal = models.reduce(
  (n, m) => n + m.prompts.reduce((k, p) => k + p.images.length, 0),
  0,
);
---

<Base
  title="Crungus Amongus — one made-up word across the image model era"
  description="An archive of the crungus: the creature that text-to-image models summon from a word that means nothing, recorded across the models of 2021–2026."
>
  <section class="hero">
    <h1>The crungus, observed</h1>
    <p class="lede">
      In June 2022, comedian Guy Kelly typed a word he made up — <em>crungus</em> —
      into DALL·E&nbsp;mini, and the model answered ten times with the same hairy
      goat-demon. This archive asks every text-to-image model on{" "}
      <a href="https://replicate.com">Replicate</a>{" "}
      the same question: {imageTotal} images from {models.length} models, from
      the word alone.
    </p>
    {
      strip.length > 1 && (
        <ol class="filmstrip" aria-label="one crungus per year">
          {strip.map((model) => {
            const key = coverImage(model);
            const image = key ? localImage(key) : null;
            return (
              <li>
                <a href={`${base}/model/${model.slug}/`}>
                  {image && (
                    <Image
                      src={image}
                      alt={`crungus in ${releaseYear(model)}, by ${model.owner}/${model.name}`}
                      widths={[160, 320]}
                      sizes="160px"
                    />
                  )}
                  <span class="mono muted">{releaseYear(model)}</span>
                </a>
              </li>
            );
          })}
        </ol>
      )
    }
  </section>

  <section aria-labelledby="archive-heading">
    <div class="archive-head">
      <h2 id="archive-heading">The archive</h2>
      <p class="mono sort" hidden>
        <span class="muted">order by</span>
        <button id="sort-year" aria-pressed="true" type="button">year</button>
        <button id="sort-score" aria-pressed="false" type="button">consistency</button>
      </p>
    </div>

    <div id="by-year">
      {
        years.map(([year, group]) => (
          <section class="year" aria-label={`models from ${year}`}>
            <h3 class="mono muted">{year}</h3>
            <div class="grid">
              {group.map((model) => (
                <ModelCard model={model} />
              ))}
            </div>
          </section>
        ))
      }
    </div>

    <div id="by-score" hidden>
      <div class="grid">
        {scored.map((model) => <ModelCard model={model} />)}
      </div>
    </div>
  </section>

  {
    failed.length > 0 && (
      <section class="failed" aria-labelledby="failed-heading">
        <h2 id="failed-heading">Did not answer</h2>
        <p class="muted">
          Old models rot: weights vanish, hardware retires, safety filters
          refuse. These models were asked and produced nothing.
        </p>
        <ul class="mono">
          {failed.map((model) => (
            <li>
              <a href={model.replicate_url}>
                {model.owner}/{model.name}
              </a>
              <span class="muted"> — {model.status}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>

<script>
  // progressive enhancement: the sort toggle only appears when JS runs
  const controls = document.querySelector<HTMLElement>(".sort");
  const byYearEl = document.getElementById("by-year");
  const byScoreEl = document.getElementById("by-score");
  const yearBtn = document.getElementById("sort-year");
  const scoreBtn = document.getElementById("sort-score");

  if (controls && byYearEl && byScoreEl && yearBtn && scoreBtn) {
    controls.hidden = false;
    const select = (score: boolean) => {
      byYearEl.hidden = score;
      byScoreEl.hidden = !score;
      yearBtn.setAttribute("aria-pressed", String(!score));
      scoreBtn.setAttribute("aria-pressed", String(score));
    };
    yearBtn.addEventListener("click", () => select(false));
    scoreBtn.addEventListener("click", () => select(true));
  }
</script>

<style>
  .hero {
    padding-block: 2.5rem 3rem;
  }

  h1 {
    font-size: clamp(2.2rem, 6vw, 3.6rem);
    margin: 0 0 1rem;
  }

  .lede {
    max-width: 46rem;
    font-size: 1.1rem;
    margin: 0 0 2.25rem;
  }

  .filmstrip {
    list-style: none;
    display: flex;
    gap: 0.5rem;
    padding: 0;
    margin: 0;
    overflow-x: auto;
  }

  .filmstrip li {
    flex: 0 0 auto;
  }

  .filmstrip a {
    display: block;
    text-decoration: none;
  }

  .filmstrip img {
    display: block;
    width: clamp(96px, 14vw, 160px);
    aspect-ratio: 1;
    object-fit: cover;
    background: var(--surface);
  }

  .filmstrip span {
    display: block;
    padding-top: 0.3rem;
  }

  .filmstrip a:hover span {
    color: var(--accent-bright);
  }

  .archive-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  h2 {
    font-size: 1.6rem;
    margin: 0 0 0.75rem;
  }

  .sort button {
    background: none;
    border: 1px solid var(--line);
    color: var(--muted);
    font: inherit;
    padding: 0.2rem 0.7rem;
    cursor: pointer;
  }

  .sort button[aria-pressed="true"] {
    color: var(--ground);
    background: var(--accent);
    border-color: var(--accent);
  }

  .year h3 {
    font-size: 0.9rem;
    font-weight: 500;
    border-block-end: 1px solid var(--line);
    padding-block-end: 0.4rem;
    margin: 2rem 0 1rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(170px, 44vw), 1fr));
    gap: 1.25rem 1rem;
  }

  .failed {
    margin-block-start: 3.5rem;
  }

  .failed ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.35rem;
  }
</style>
