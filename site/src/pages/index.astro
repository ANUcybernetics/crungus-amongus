---
import CrungusImage from "../components/CrungusImage.astro";
import ModelCard from "../components/ModelCard.astro";
import Base from "../layouts/Base.astro";
import { siteData } from "../lib/data";
import { bucketUrl } from "../lib/images";
import {
  byCrungusness,
  byYear,
  generatedModels,
  meshedImages,
  timelineSample,
} from "../lib/models";
import { path } from "../lib/paths";

// the huddle beside the introduction: chosen meshes standing together, all
// facing out of the page. Placed back to front, so the flanks are drawn last
// and stand over the one at the back, between them
const huddlePlaces = [
  { key: "qwen--qwen-image-2/crungus/33.avif", place: "back" },
  { key: "google--imagen-4-fast/crungus/79.avif", place: "left" },
  { key: "black-forest-labs--flux-2-flex/crungus/79.avif", place: "right" },
];
const meshed = meshedImages(siteData);
// any whose mesh has gone from the data simply leaves a gap
const huddle = huddlePlaces.flatMap(({ key, place }) => {
  const found = meshed.find(({ image }) => image.key === key);
  return found ? [{ ...found, place }] : [];
});

const models = generatedModels(siteData, "image");
const strip = timelineSample(models);
const years = byYear(models);
const scored = byCrungusness(models);
const imageTotal = models.reduce(
  (n, m) => n + m.prompts.reduce((k, p) => k + p.images.length, 0),
  0,
);
---

<Base
  title="Crungus Amongus — cryptid mining in latent space"
  description="An interactive archive comparing images and sounds generated by AI models from prompts containing crungus."
  unfold
>
  <section class="hero">
    <div class="intro">
      {/* the title and the introduction together, held in the middle of the
          window below the masthead, rather than the title in the masthead's
          own heading slot */}
      <div class="ledes">
        <div class="heading"><h1>Cryptid Mining in Latent Space</h1></div>
        <p class="lede">
          “Crungus” may sound familiar, like something from a fairy tale or half-forgotten
          children's movie, but the word was originally meaningless by design. It was coined in June
          2022 by Guy Kelly, who found that entering “crungus” into the DALL·E mini image generator
          produced reliably monstrous results: some kind of ogrish creature, clawed, horned and
          hairy, like an orc from <em>The Lord of the Rings</em>.
        </p>
        <p class="lede">
          Kelly's experiment was widely replicated, and the crungus became famous as the first
          cryptid of latent space. Today, the term continues to generate monstrous imagery across AI
          models. For this project, we had {models.length} different models on Replicate produce 100
          different images of the crungus for each of the prompts “crungus” and “a picture of a
          crungus”, without any style instructions or fixed seeds.
        </p>
        <p class="lede">
          The resulting menagerie reflects the many and varied shades of modern monstrousness,
          spanning the medieval and the alien, the creepy and the kawaii, the malevolent and the
          misunderstood.
        </p>
        <p class="lede">
          Browse {imageTotal.toLocaleString("en-AU")} images from {models.length} models, explore
          the <a href={path("/atlas/")}>atlas</a>, or use the
          <a href={path("/eigen/")}>eigencrungi sliders</a> to examine variation.
          <a href={path("/about/")}>About the research and collection method</a>.
        </p>
      </div>
      <div class="beside">
        {huddle.length > 0 && <div class="huddle">
          {huddle.map(({ model, prompt, image, place }) => (
            <model-viewer
              class={place}
              src={bucketUrl(image.mesh)}
              alt={`3D mesh of a crungus by ${model.owner}/${model.name} for “${prompt.prompt}”`}
              interaction-prompt="none"
              disable-zoom
              disable-pan
              disable-tap
              camera-orbit="0deg 82deg auto"
              tone-mapping="aces"
              exposure="0.45"
              shadow-intensity="0.6"
              shadow-softness="1"
            />
          ))}
        </div>}
      </div>
      {/* the site's name, which the masthead cuts down to its o; the masthead
        also carries it in full for screen readers, so it isn't read twice */}
      <div class="name-box">
        <p class="name" aria-hidden="true">crungus am<span class="accent">o</span>ngus</p>
      </div>
    </div>
    <h2 class="page-heading strip-heading">The Crungus Through the Years</h2>
    <p class="section-intro">The Most Typical Crungus from Each Year's Model</p>
    {strip.length > 1 && <ol
      class="filmstrip"
      aria-label="representative images grouped by model release year"
    >
      {strip.map((sample) => <li>
        <a href={path(`/model/${sample.model.slug}/`)}>
          <CrungusImage
            image={sample.key}
            alt={`representative output from a model released in ${sample.year}, by ${sample.model.owner}/${sample.model.name}`}
            sizes="(width < 40rem) 96px, calc((100vw - 8rem) / 6)"
          />
          <span class="strip-year">{sample.year}</span>
        </a>
      </li>)}
    </ol>}
  </section>

  <section aria-labelledby="archive-heading">
    <div class="archive-head">
      <h2 class="page-heading" id="archive-heading">The Image Archive</h2>
      <p class="mono sort" hidden>
        <span class="muted">order by</span>
        <button id="sort-year" aria-pressed="true" type="button">year</button>
        <button id="sort-score" aria-pressed="false" type="button">consistency</button>
      </p>
    </div>
    <p class="section-intro">Models from 2021—2026</p>

    <div id="by-year">
      {years.map(([year, group]) => <section class="year" aria-label={`models from ${year}`}>
        <h3 class="mono muted">{year}</h3>
        <div class="grid">
          {group.map((model) => (
            <ModelCard model={model} />
          ))}
        </div>
      </section>)}
    </div>

    <div id="by-score" hidden>
      <div class="grid">
        {scored.map((model) => (
          <ModelCard model={model} />
        ))}
      </div>
    </div>
  </section>
</Base>

<script>
  import { loadModelViewer } from "../lib/mesh-viewer";

  // the huddle: <model-viewer> (and three.js with it) only loads when there
  // are meshes to show, and each crungus fades in as its mesh arrives
  const huddled = document.querySelectorAll<HTMLElement & { loaded?: boolean }>(
    ".huddle model-viewer",
  );
  if (huddled.length > 0) {
    for (const viewer of huddled) {
      const shown = () => viewer.classList.add("loaded");
      if (viewer.loaded) shown();
      else viewer.addEventListener("load", shown, { once: true });
    }
    // a viewer that won't load leaves the space empty, as it was before
    loadModelViewer().catch(() => {});
  }

  // eased in and out, clamped to 0 to 1
  const smooth = (t: number) => {
    const c = Math.min(1, Math.max(0, t));
    return c * c * (3 - 2 * c);
  };

  // the masthead's o opens into the full name once the name under the huddle
  // has half gone beneath the masthead's foot, and folds back up once it
  // comes back out: either way the whole movement plays through on its own,
  // in OPEN_MS, rather than following the scroll. Base.astro's .fold styles
  // say what each property does
  const masthead = document.querySelector<HTMLElement>(".masthead");
  const name = document.querySelector<HTMLElement>(".name");
  const before = masthead?.querySelector<HTMLElement>(".fold.before");
  const after = masthead?.querySelector<HTMLElement>(".fold.after");
  if (masthead && name && before && after) {
    const still = matchMedia("(prefers-reduced-motion: reduce)");
    // how long the whole opening (or closing) takes
    const OPEN_MS = 1400;
    // how far the drawing out trails the o, of the whole opening
    const TRAIL = 0.12;
    // how far a letter travels from the o's edge before it's fully up
    const FADE_EM = 0.9;
    // where the movement is, 0 folded to 1 open, and where it's heading
    let shown = 0;
    let target = 0;
    let frame = 0;
    let last = 0;
    const under = () => {
      // on a phone the masthead scrolls away with the name, so stays an o
      if (getComputedStyle(masthead).position !== "sticky") return false;
      const foot = masthead.getBoundingClientRect().bottom;
      const { top, height } = name.getBoundingClientRect();
      return foot - top > height / 2;
    };
    const paint = (u: number) => {
      masthead.style.setProperty("--slide", smooth(u / (1 - TRAIL)).toFixed(4));
      masthead.style.setProperty("--extrude", smooth((u - TRAIL) / (1 - TRAIL)).toFixed(4));
      masthead.style.setProperty("--done", smooth((u - 0.8) / 0.2).toFixed(4));
    };
    // at a steady pace towards the target, the easing coming from paint's
    // curves; turning back part way reverses from wherever it has got to
    const step = (now: number) => {
      const dt = last ? now - last : 16;
      last = now;
      const reach = dt / OPEN_MS;
      shown =
        still.matches || Math.abs(target - shown) <= reach
          ? target
          : shown + Math.sign(target - shown) * reach;
      paint(shown);
      frame = shown === target ? 0 : requestAnimationFrame(step);
      if (!frame) last = 0;
    };
    const check = () => {
      const next = under() ? 1 : 0;
      if (next === target) return;
      target = next;
      if (!frame) frame = requestAnimationFrame(step);
    };
    // the halves' and letters' sizes, which change with the font's arrival
    // and the root size, which follows the window's width
    new ResizeObserver(() => {
      const fade = FADE_EM * parseFloat(getComputedStyle(before).fontSize);
      masthead.style.setProperty("--fold-before", `${before.offsetWidth}px`);
      for (const [half, key] of [
        [before, "before"],
        [after, "after"],
      ] as const) {
        masthead.style.setProperty(`--fade-gain-${key}`, String(half.offsetWidth / fade));
        for (const letter of half.querySelectorAll<HTMLElement>(".letter")) {
          const at = (letter.offsetLeft + letter.offsetWidth / 2) / half.offsetWidth;
          letter.style.setProperty("--at", at.toFixed(4));
        }
      }
      check();
    }).observe(before);
    addEventListener("scroll", check, { passive: true });
    addEventListener("resize", check);
    // a reload part way down starts open, without playing
    target = shown = under() ? 1 : 0;
    paint(shown);
  }

  // progressive enhancement: the sort toggle only appears when JS runs
  const controls = document.querySelector<HTMLElement>(".sort");
  const byYearEl = document.getElementById("by-year");
  const byScoreEl = document.getElementById("by-score");
  const yearBtn = document.getElementById("sort-year");
  const scoreBtn = document.getElementById("sort-score");

  if (controls && byYearEl && byScoreEl && yearBtn && scoreBtn) {
    controls.hidden = false;
    const select = (score: boolean) => {
      byYearEl.hidden = score;
      byScoreEl.hidden = !score;
      yearBtn.setAttribute("aria-pressed", String(!score));
      scoreBtn.setAttribute("aria-pressed", String(score));
    };
    yearBtn.addEventListener("click", () => select(false));
    scoreBtn.addEventListener("click", () => select(true));
  }
</script>

<style>
  /* twice the space the strip had above the archive */
  .hero {
    padding-block: 2.5rem 6rem;
  }

  h1 {
    margin: 0 0 1rem;
  }

  /* the title and the introduction, centred in the space between the pinned
     masthead and the foot of the window */
  .ledes {
    grid-column: 1;
    grid-row: 2;
    container-type: inline-size;
  }

  /* the block ends at the last line of text, for the name to line up with */
  .ledes .lede:last-child {
    margin-block-end: 0;
  }

  /* the title on one line: its usual size where the column holds it, and
     just small enough to fit where it doesn't (the larger type on a wide screen). The
     line is about 19.8em wide, so 5cqi is the size that fills the column */
  .ledes h1 {
    font-size: min(1.875rem, 5cqi);
    white-space: nowrap;
  }

  /* set as the about page's prose: body size, a line's gap between
     paragraphs, but across about half the window rather than 65 characters */
  .lede {
    margin: 0 0 1em;
  }

  /* past global.css's 65-character measure for prose */
  .ledes .lede {
    max-width: none;
  }

  /* the introduction on the left, the huddle in the space beside it */
  .intro {
    display: grid;
    /* the text takes the window's left half, less the page's margin */
    grid-template-columns: minmax(0, calc(50vw - var(--gutter))) minmax(0, 1fr);
    /* the title and text in the middle row, centred in the window below the
       masthead by the equal rows either side; the huddle spans all three
       from the top, and the name ends the middle row, so its baseline is the
       last lede's */
    grid-template-rows: 1fr auto 1fr;
    min-height: calc(100svh - var(--masthead-height, 0px));
    align-items: start;
    column-gap: clamp(2rem, 4vw, 5rem);
  }

  /* the huddle: three meshes overlapping closely in a shallow arc, sized and
     placed in units of its own width, which is the whole column beside the
     text. The back one stands a little smaller and higher, the flanks a step
     forward and over it. Each canvas is transparent, so the one behind shows
     round those in front */
  .huddle {
    position: relative;
    container-type: inline-size;
    justify-self: center;
    width: 100%;
    aspect-ratio: 100 / 90;
  }

  /* the huddle, from the top of the intro, with the name over its feet */
  .beside {
    grid-column: 2;
    grid-row: 1 / -1;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 0;
    /* room for the back one's antlers, which rise past the huddle's top,
       to clear the pinned masthead */
    padding-block-start: 4rem;
    container-type: inline-size;
  }

  /* the large lowercase Archiv the masthead used to carry, the o in the
     accent */
  /* on one line, spread across the column's whole width: the name measures
     8.484em, so 100cqi / 8.484 = 11.78cqi makes it exactly as wide */
  .name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 11.78cqi;
    white-space: nowrap;
    line-height: 1;
    letter-spacing: 0.005em;
    color: var(--text);
  }

  /* in the huddle's column, over the creatures' legs, and lined up on the
     last lede's baseline. Its own container, so the name's size is still in
     the column's width */
  .name-box {
    grid-column: 2;
    grid-row: 2;
    position: relative;
    /* over every mesh in the huddle */
    z-index: 3;
    display: flex;
    justify-content: center;
    min-width: 0;
    container-type: inline-size;
  }

  .ledes,
  .name-box {
    align-self: last baseline;
  }

  .name .accent {
    color: var(--accent);
  }

  /* the meshes' boxes are wider than the creatures in them, so they reach
     past the column; their edges are transparent, and clipping them here
     keeps the page from scrolling sideways */
  .intro {
    overflow-x: clip;
  }

  .huddle model-viewer {
    --size: 69;

    position: absolute;
    inset-inline-start: calc(var(--x) * 1cqi);
    inset-block-start: calc(var(--y) * 1cqi);
    width: calc(var(--size) * 1cqi);
    /* the element's own :host style fixes a 150px height */
    height: auto;
    aspect-ratio: 1;
    /* decoration beside the text: the page scrolls through it */
    pointer-events: none;
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  .huddle model-viewer.loaded {
    opacity: 1;
  }

  /* each is placed by its centre: the flanks at 31 and 63, the back one
     between them at 47, so the creatures overlap shoulder to shoulder. The
     flanks stand lower, and the back one rises into the space above the
     huddle's top (empty above its head), so its head shows over theirs */
  .huddle .back {
    --x: 12.5;
    --y: -6;
  }

  /* the left one stands at the front, the right one just behind it, and
     the back one behind both */
  .huddle .left {
    z-index: 2;
    --size: 78;
    --x: -7.75;
    --y: 12;
  }

  .huddle .right {
    z-index: 1;
    --size: 78;
    --x: 23.75;
    --y: 12;
  }

  /* too narrow to sit side by side: the huddle under the introduction */
  @media (width < 64rem) {
    /* stacked, the text just leads, with the huddle and the name under it */
    .intro {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      min-height: 0;
    }

    .ledes,
    .beside,
    .name-box {
      grid-column: 1;
      grid-row: auto;
    }

    .huddle {
      max-width: 44rem;
      margin-block-end: 2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .huddle model-viewer {
      transition: none;
    }
  }

  /* twice the last lede's 2.25rem, which this margin collapses into; none
     below, so the gap to the intro is the intro's own margin */
  .strip-heading {
    margin: 4.5rem 0 0;
  }

  /* the section's subheading under its heading: Adequate Extra Light, at
     about the size of the text around it, in the title case the markup is
     written in */
  .section-intro {
    margin-block-start: 0.5em;
    font-family: var(--font-intro);
    font-size: 0.975em;
    font-weight: 200;
    color: var(--title);
  }

  .filmstrip {
    list-style: none;
    display: flex;
    gap: 0.5rem;
    padding: 0;
    margin: 0;
    /* scrolls sideways on a phone; overflow-x alone would make the y axis
       auto too, and the large years would give it a sliver of vertical scroll */
    overflow: auto hidden;
  }

  /* the strip shares the full width equally; on a phone each keeps a usable
     size and the strip scrolls instead */
  .filmstrip li {
    flex: 1 1 0;
    min-width: 6rem;
  }

  .filmstrip a {
    display: block;
    text-decoration: none;
  }

  .filmstrip img {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    background: var(--surface); /* washed like the archive's cards until hovered */
    filter: saturate(0.45) contrast(0.95);
    transition: filter 0.6s ease;
  }

  .filmstrip a:is(:hover, :focus-visible) img {
    filter: none;
  }

  .strip-year {
    display: block;
    font-weight: var(--numeral-weight);
    padding-top: 0.4rem;
    font-family: var(--font-body);
    font-size: clamp(1.25rem, 2.2vw, 2.25rem);
    line-height: 1.2;
    color: var(--title);
  }

  .filmstrip a:hover span {
    color: var(--hover);
  }

  .archive-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* margins in a flex row don't collapse into the intro's below it, so they
     go, leaving the intro's own margin as the gap the strip heading has */
  .archive-head > * {
    margin-block: 0;
  }

  h2 {
    margin: 0 0 0.75rem;
  }

  /* the section headings, in Archiv from the global h1-h3 rule; the title is
     set in global.css */
  /* in the page title's colour (and, from global.css, its size), so the sections read as its peers */
  .page-heading {
    color: var(--title);
  }

  h2,
  .hero p {
    color: var(--title);
  }

  /* links in the paragraphs take the paragraph's colour, and still turn to
     the hover colour; :not(:hover) leaves the global a:hover rule to apply */
  .hero p a:not(:hover) {
    color: inherit;
  }

  .sort button {
    background: none;
    border: 1px solid var(--line);
    color: var(--muted);
    font: inherit;
    padding: 0.2rem 0.7rem;
    cursor: pointer;
  }

  .sort button[aria-pressed="true"] {
    color: var(--ground);
    background: var(--accent);
    border-color: var(--accent);
  }

  /* a ledger: each year in the left margin, its models beside it, a rule
     across the top of both. The year stays in view, under the pinned
     masthead, while its models scroll past */
  .year {
    display: grid;
    grid-template-columns: 7rem 1fr;
    align-items: start;
    border-block-start: 1px solid var(--line);
    padding-block-start: 1rem;
    margin-block-start: 3rem;
  }

  /* set as the filmstrip's years, over the mono class's utility voice */
  .year h3 {
    position: sticky;
    top: calc(var(--masthead-height, 0px) + 1rem);
    font-family: var(--font-body);
    font-size: clamp(1.25rem, 2.2vw, 2.25rem);
    font-weight: var(--numeral-weight);
    line-height: 1;
    letter-spacing: normal;
    margin: 0;
  }

  /* too narrow for a margin: the year over its models again */
  @media (width < 40rem) {
    .year {
      grid-template-columns: 1fr;
      row-gap: 1rem;
    }

    .year h3 {
      position: static;
    }
  }

  .grid {
    display: grid;
    /* plates of at least 240px at desk size, as the bestiary's specimen index */
    grid-template-columns: repeat(auto-fill, minmax(min(15rem, 44vw), 1fr));
    gap: clamp(0.875rem, 1.6vw, 1.625rem) clamp(0.625rem, 1.2vw, 1.25rem);
  }
</style>
