---
import Base from "../layouts/Base.astro";
import { siteData } from "../lib/data";
import { bucketUrl } from "../lib/images";
import { meshedImages } from "../lib/models";
import { path } from "../lib/paths";
import { itemNumber, itemPath } from "../lib/permalink";

const meshes = meshedImages(siteData);
---

<Base
  title="Meshes — Crungus Amongus"
  description="Archive crungus images reconstructed as textured 3D meshes with Meshy's image-to-3D model."
>
  <h1 slot="heading">Crungi in the round</h1>
  <section class="hero">
    <p class="lede">
      A handful of archive images, chosen by hand, given to <a href="https://www.meshy.ai/">Meshy</a>'s image-to-3D model.
      It has one picture to go on, so everything the image does not show (the back, the far side, the underside) is Meshy's guess.
      Each mesh is listed with its source image in <a href={path("/api/meshes.json")}>the JSON API</a>.
    </p>
  </section>

  {
    meshes.length === 0 ? (
      <p class="muted">No meshes yet.</p>
    ) : (
      <ul class="meshes">
        {meshes.map(({ model, prompt, image }) => (
          <li>
            <div class="stage">
              <model-viewer
                src={bucketUrl(image.mesh)}
                alt={`3D mesh of a crungus by ${model.owner}/${model.name} for “${prompt.prompt}”`}
                loading="lazy"
                camera-controls
                touch-action="pan-y"
                interaction-prompt="none"
                auto-rotate
                auto-rotate-delay="0"
                rotation-per-second="7deg"
                camera-orbit="0deg 82deg auto"
                tone-mapping="aces"
                exposure="0.5"
                shadow-intensity="0.6"
                shadow-softness="1"
              />
              <span class="loading" role="status">
                <span aria-hidden="true">o</span>
                <span class="visually-hidden">loading mesh</span>
              </span>
            </div>
            <p class="caption-label">
              <a href={path(`/model/${model.slug}/`)}>{model.owner}/<wbr />{model.name}</a>
              <span class="caption-note">“{prompt.prompt}”</span>
              <span class="actions">
                <a href={bucketUrl(image.key)}>image</a> · <a href={bucketUrl(image.mesh)} download>glb</a> ·{" "}
                <button
                  type="button"
                  class="share"
                  data-share={itemPath(image.key)}
                  data-title={`“${prompt.prompt}” #${itemNumber(image.key)} by ${model.owner}/${model.name}, in 3D — Crungus Amongus`}
                >
                  share
                </button>
              </span>
            </p>
          </li>
        ))}
      </ul>
    )
  }
</Base>

<script>
  import { loadModelViewer } from "../lib/mesh-viewer";
  import { bindShareButtons } from "../lib/share";

  bindShareButtons();

  // each mesh fades in over its loading o once it has arrived
  for (const viewer of document.querySelectorAll<HTMLElement & { loaded?: boolean }>(".stage model-viewer")) {
    const shown = () => viewer.parentElement?.classList.add("loaded");
    if (viewer.loaded) shown();
    else viewer.addEventListener("load", shown, { once: true });
  }

  if (document.querySelector("model-viewer")) void loadModelViewer();
</script>

<style>
  .hero {
    padding-block: 2.5rem 2rem;
  }

  h1 {
    font-size: clamp(2.2rem, 6vw, 3.6rem);
    margin: 0 0 1rem;
  }

  .lede {
    font-size: 1.1rem;
    color: var(--title);
    margin: 0 0 1.25rem;
  }

  .meshes {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(22rem, 100%), 1fr));
    gap: 1.5rem;
  }

  .stage {
    position: relative;
    display: grid;
    /* the page's own ground, lit from behind by the bestiary's warm glow; the
       canvas is transparent, so the glow reads through around the creature */
    background-color: var(--ground);
    background-image: radial-gradient(
      ellipse 42% 58% at 50% 50%,
      rgb(72 58 30 / 70%) 0%,
      rgb(72 58 30 / 32%) 45%,
      rgb(72 58 30 / 0%) 100%
    );
    background-repeat: no-repeat;
  }

  .stage > * {
    grid-area: 1 / 1;
  }

  model-viewer {
    display: block;
    width: 100%;
    /* the element's own :host style fixes a 150px height */
    height: auto;
    aspect-ratio: 1;
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  /* the wordmark's amber o, breathing until its mesh arrives */
  .loading {
    place-self: center;
    font-family: var(--font-display);
    font-size: 86px;
    line-height: 1;
    color: var(--accent);
    pointer-events: none;
    transition: opacity 0.6s ease;
  }

  .loaded model-viewer {
    opacity: 1;
  }

  .loaded .loading {
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .loading [aria-hidden] {
      display: block;
      animation: breathe 1.6s ease-in-out infinite alternate;
    }
  }

  @keyframes breathe {
    from {
      opacity: 0.35;
      scale: 0.9;
    }

    to {
      opacity: 1;
      scale: 1;
    }
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  li p {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    margin: 0.5rem 0 0;
    align-items: baseline;
    overflow-wrap: anywhere;
  }

  /* image · glb · share wrap as one unit */
  li p .actions {
    white-space: nowrap;
  }

  /* the share button takes the caption's label voice, not its own mono one */
  li p .share {
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
  }
</style>
