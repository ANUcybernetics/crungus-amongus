---
import SoundCard from "../components/SoundCard.astro";
import Base from "../layouts/Base.astro";
import { siteData } from "../lib/data";
import { byCrungusness, byYear, clipCount, generatedModels } from "../lib/models";
import { path } from "../lib/paths";

const models = generatedModels(siteData, "audio");
const years = byYear(models);
const scored = byCrungusness(models);
const clipTotal = models.reduce((n, m) => n + clipCount(m), 0);
// the span of dated release years, for the subheading under the archive heading
const dated = years.map(([year]) => year).filter((year) => year !== "undated");
const span = dated.at(0) === dated.at(-1) ? dated.at(0) : `${dated.at(0)}—${dated.at(-1)}`;
---

<Base
  title="Sound — Crungus Amongus"
  description="Compare audio generated from crungus prompts by music and speech models available through Replicate."
>
  <h1 slot="heading">The Sound of Crungus</h1>
  <section class="hero">
    <p class="lede">
      Music and speech models from Replicate's
      <a href="https://replicate.com/collections/ai-music-generation">music collection</a> and a
      curated selection were given “crungus” and “the sound of a crungus”. We request twenty-second
      clips where supported; duration otherwise depends on the endpoint. Clips are
      loudness-normalised for playback. <a href={path("/about/#consistency")}>Audio consistency</a>
      measures similarity within each model's clips using CLAP.
      {clipTotal > 0 && ` ${clipTotal} clips from ${models.length} models.`}
    </p>
    {clipTotal > 0 && <p class="tune mono">
      <a href={path("/display/?radio")}>tune in to crungus radio →</a>
      <span class="muted"> every clip, shuffled, over every image</span>
    </p>}
  </section>

  {clipTotal === 0 ? (
    <p class="muted">Nothing on the air yet — the sound archive is still being recorded.</p>
  ) : (
    <section aria-labelledby="sound-heading">
      <div class="archive-head">
        <h2 id="sound-heading">The Sound Archive</h2>
        <p class="mono sort" hidden>
          <span class="muted">order by</span>
          <button id="sort-year" aria-pressed="true" type="button">year</button>
          <button id="sort-score" aria-pressed="false" type="button">consistency</button>
        </p>
      </div>
      {span && <p class="section-intro">Models from {span}</p>}
      <div id="by-year">
        {years.map(([year, group]) => <section class="year" aria-label={`models from ${year}`}>
          <h3 class="mono muted">{year}</h3>
          <div class="grid">
            {group.map((model) => (
              <SoundCard model={model} />
            ))}
          </div>
        </section>)}
      </div>
      <div id="by-score" hidden>
        <div class="grid">
          {scored.map((model) => (
            <SoundCard model={model} />
          ))}
        </div>
      </div>
    </section>
  )}
</Base>

<script>
  // progressive enhancement: the sort toggle only appears when JS runs
  const controls = document.querySelector<HTMLElement>(".sort");
  const byYearEl = document.getElementById("by-year");
  const byScoreEl = document.getElementById("by-score");
  const yearBtn = document.getElementById("sort-year");
  const scoreBtn = document.getElementById("sort-score");

  if (controls && byYearEl && byScoreEl && yearBtn && scoreBtn) {
    controls.hidden = false;
    const select = (score: boolean) => {
      byYearEl.hidden = score;
      byScoreEl.hidden = !score;
      yearBtn.setAttribute("aria-pressed", String(!score));
      scoreBtn.setAttribute("aria-pressed", String(score));
    };
    yearBtn.addEventListener("click", () => select(false));
    scoreBtn.addEventListener("click", () => select(true));
  }
</script>

<style>
  .hero {
    padding-block: 2.5rem 2rem;
  }

  h1 {
    font-size: clamp(2.2rem, 6vw, 3.6rem);
    margin: 0 0 1rem;
  }

  .lede {
    font-size: 1.1rem;
    color: var(--title);
    margin: 0 0 1.25rem;
  }

  .tune {
    margin: 0;
  }

  .archive-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* margins in a flex row don't collapse into the intro's below it, so they
     go, leaving the intro's own margin as the gap, as on the image archive */
  .archive-head > * {
    margin-block: 0;
  }

  h2 {
    margin: 0 0 0.75rem;
  }

  /* the page title's colour, as the image archive's heading */
  #sound-heading {
    color: var(--title);
  }

  .sort button {
    background: none;
    border: 1px solid var(--line);
    color: var(--muted);
    font: inherit;
    padding: 0.2rem 0.7rem;
    cursor: pointer;
  }

  .sort button[aria-pressed="true"] {
    color: var(--ground);
    background: var(--accent);
    border-color: var(--accent);
  }

  #by-score .grid {
    margin-block-start: 1rem;
  }

  /* the section's subheading under its heading: italic Manrope at half as
     big again as the text around it, in the title case the markup is
     written in */
  .section-intro {
    font-family: var(--font-body);
    font-size: 1.5em;
    font-style: italic;
    color: var(--title);
  }

  /* the image archive's years, over the mono class's utility voice */
  .year h3 {
    font-family: var(--font-body);
    font-size: clamp(1.25rem, 2.2vw, 2.25rem);
    font-weight: var(--numeral-weight);
    line-height: 1.2;
    letter-spacing: normal;
    border-block-end: 1px solid var(--line);
    padding-block-end: 0.4rem;
    margin: 4rem 0 2rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(20rem, 100%), 1fr));
    gap: 1rem;
  }
</style>
