---
import VideoCard from "../components/VideoCard.astro";
import Base from "../layouts/Base.astro";
import { siteData } from "../lib/data";
import { byYear, generatedModels, videoCount } from "../lib/models";
import { path } from "../lib/paths";

const models = generatedModels(siteData, "video");
const years = byYear(models);
const videoTotal = models.reduce((n, m) => n + videoCount(m), 0);
// the span of dated release years, for the subheading under the archive heading
const dated = years.map(([year]) => year).filter((year) => year !== "undated");
const span = dated.at(0) === dated.at(-1) ? dated.at(0) : `${dated.at(0)}—${dated.at(-1)}`;
---

<Base
  title="Video — Crungus Amongus"
  description="Compare video clips generated from crungus prompts by text-to-video models available through Replicate."
>
  <h1 slot="heading">The Crungus in Motion</h1>
  <section class="hero">
    <p class="lede">
      Models from Replicate's
      <a href="https://replicate.com/collections/text-to-video">text-to-video collection</a> were
      given “crungus” and “a video of a crungus”. Each clip runs at the model's default length, and
      carries a soundtrack wherever the model can make one.
      {videoTotal > 0 && ` ${videoTotal} clips from ${models.length} models.`}
    </p>
    {videoTotal > 0 && <p class="watch mono">
      <a href={path("/display/video/")}>watch them all →</a>
      <span class="muted"> every clip, shuffled, full screen</span>
    </p>}
  </section>

  {videoTotal === 0 ? (
    <p class="muted">Nothing showing yet: the video archive is still being filmed.</p>
  ) : (
    <section aria-labelledby="video-heading">
      <h2 id="video-heading">The Video Archive</h2>
      {span && <p class="section-intro">Models from {span}</p>}
      {years.map(([year, group]) => <section class="year" aria-label={`models from ${year}`}>
        <h3 class="mono muted">{year}</h3>
        <div class="grid">
          {group.map((model) => (
            <VideoCard model={model} />
          ))}
        </div>
      </section>)}
    </section>
  )}
</Base>

<style>
  .hero {
    padding-block: 2.5rem 2rem;
  }

  h1 {
    font-size: clamp(2.2rem, 6vw, 3.6rem);
    margin: 0 0 1rem;
  }

  .lede {
    font-size: 1.1rem;
    color: var(--title);
    margin: 0 0 1.25rem;
  }

  .watch {
    margin: 0;
  }

  h2 {
    font-size: 1.6rem;
    margin: 0 0 0.75rem;
  }

  /* the archive's heading, the size of the image archive's; that heading's row
     is ~3px deeper than it, as its sort buttons hang below the baseline, and
     this page has none, so the margin makes up the gap to the intro */
  /* the page title's size and colour, as the image archive's heading */
  #video-heading {
    font-size: 2.5rem;
    color: var(--title);
    margin-block-end: 1.1875rem;
  }

  /* the section's subheading under its heading: letterspaced Archiv
     capitals */
  .section-intro {
    font-family: var(--font-display);
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--title);
  }

  /* the image archive's years, over the mono class's utility voice */
  .year h3 {
    font-family: var(--font-body);
    font-size: clamp(1.25rem, 2.2vw, 2.25rem);
    font-weight: var(--numeral-weight);
    line-height: 1.2;
    letter-spacing: normal;
    border-block-end: 1px solid var(--line);
    padding-block-end: 0.4rem;
    margin: 4rem 0 2rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(22rem, 100%), 1fr));
    gap: 1rem;
  }
</style>
