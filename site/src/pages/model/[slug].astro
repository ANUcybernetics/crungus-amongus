---
import { Image } from "astro:assets";

import AudioClip from "../../components/AudioClip.astro";
import ConsistencyMeter from "../../components/ConsistencyMeter.astro";
import Base from "../../layouts/Base.astro";
import { siteData } from "../../lib/data";
import { bucketUrl, localImage } from "../../lib/images";
import { coverImage, generatedModels, refusalRate, releaseYear } from "../../lib/models";
import { path } from "../../lib/paths";
import { itemAnchor, itemNumber, itemPath } from "../../lib/permalink";

export function getStaticPaths() {
  return generatedModels(siteData).map((model) => ({
    params: { slug: model.slug },
    props: { model },
  }));
}

const { model } = Astro.props;
const dated = model.release_date !== null;
const audio = model.modality === "audio";
const verb = audio ? "played" : "rendered";
const shareTitle = (prompt: string, key: string) =>
  `“${prompt}” #${itemNumber(key)} by ${model.owner}/${model.name} — Crungus Amongus`;
---

<Base
  section={audio ? "sound" : "images"}
  image={audio ? null : coverImage(model)}
  title={`${model.owner}/${model.name} — Crungus Amongus`}
  description={`The crungus as ${verb} by ${model.owner}/${model.name}${dated ? ` (${releaseYear(model)})` : ""}.`}
>
  <article>
    <header>
      <p class="mono muted eyebrow">
        {dated ? `release year ${releaseYear(model)}` : "release date unknown"} · {model.source === "legacy" ? "curated selection" : "Replicate collection"} ·{" "}
        <a href={audio ? path("/sound/") : path()}>{audio ? "sound" : "image"}</a> ·{" "}
        <a href={model.replicate_url}>view on replicate</a>
      </p>
      <h1 class="mono">{model.owner}/{model.name}</h1>
      {model.description && <p class="description">{model.description}</p>}
      <p class="muted">Outputs generated for this project, grouped by prompt. <a href={path("/about/")}>Collection method and date sources</a>.</p>
    </header>

    {
      model.prompts
        .filter((prompt) => prompt.images.length + prompt.clips.length > 0)
        .map((prompt) => (
          <section aria-labelledby={`prompt-${prompt.prompt_slug}`}>
            <div class="prompt-head">
              <h2 id={`prompt-${prompt.prompt_slug}`} class="mono">
                “{prompt.prompt}”
              </h2>
              <ConsistencyMeter value={prompt.consistency} modality={model.modality} />
            </div>
            {
              // only worth saying when it happened; most models refused nothing
              (refusalRate(prompt) ?? 0) > 0 && (
                <p class="mono refusals">
                  <b>{Math.round(refusalRate(prompt)! * 100)}%</b> refused under the
                  default filters: {prompt.refusals.refused} of {prompt.refusals.asked}{" "}
                  requests were blocked, measured up to {prompt.refusals.measured_until.slice(0, 10)}.
                  Later runs use the most permissive safety settings exposed by this endpoint.
                  This historical rate does not describe the images on this page.
                </p>
              )
            }
            {audio ? (
              <ol class="clips">
                {prompt.clips.map((clip) => (
                  <li id={itemAnchor(clip.opus)}>
                    <span class="mono muted">{String(itemNumber(clip.opus)).padStart(2, "0")}</span>
                    <AudioClip
                      clip={clip}
                      preload="metadata"
                      label={`clip ${itemNumber(clip.opus)} of ${prompt.clips.length} for “${prompt.prompt}”`}
                    />
                    <button
                      type="button"
                      class="share"
                      data-share={itemPath(clip.opus)}
                      data-title={shareTitle(prompt.prompt, clip.opus)}
                      aria-label={`share clip ${itemNumber(clip.opus)} for “${prompt.prompt}”`}
                    >
                      share
                    </button>
                  </li>
                ))}
              </ol>
            ) : (
              <div class="grid">
                {prompt.images.map((image, i) => {
                  const local = localImage(image.key);
                  const n = itemNumber(image.key);
                  return (
                    local && (
                      <a
                        class="thumb"
                        id={itemAnchor(image.key)}
                        href={bucketUrl(image.key)}
                        data-alt={`crungus ${n} of ${prompt.images.length}, ${model.owner}/${model.name}, prompt “${prompt.prompt}”`}
                        data-caption={`“${prompt.prompt}” · ${n} of ${prompt.images.length}`}
                        data-title={shareTitle(prompt.prompt, image.key)}
                        data-mesh={image.mesh && bucketUrl(image.mesh)}
                      >
                        {image.mesh && (
                          <span class="mesh-badge mono" aria-hidden="true">
                            3d
                          </span>
                        )}
                        <Image
                          src={local}
                          alt={`crungus ${n} of ${prompt.images.length} for “${prompt.prompt}”${image.mesh ? ", with a 3D mesh" : ""}`}
                          format="avif"
                          widths={[240, 480]}
                          sizes="(max-width: 40rem) 44vw, 240px"
                          style={i === 0 && prompt.prompt_slug === "crungus" ? `view-transition-name: cover-${model.slug}` : undefined}
                        />
                      </a>
                    )
                  );
                })}
              </div>
            )}
          </section>
        ))
    }
  </article>

  {
    !audio && (
      <dialog id="lightbox" closedby="any" aria-label="full-size image">
        <form method="dialog">
          <img alt="" />
          <p class="mono mesh-links" hidden>
            drag to turn · <a class="image-link">image</a> · <a class="mesh-link" download>glb</a>
          </p>
          <div class="lightbox-bar mono">
            <p class="caption" aria-live="polite"></p>
            <span class="actions">
              <button type="button" class="step" data-step="-1" aria-label="previous image">
                ←
              </button>
              <button type="button" class="step" data-step="1" aria-label="next image" autofocus>
                →
              </button>
              <button type="button" class="share-current">share</button>
              <button type="submit">close</button>
            </span>
          </div>
        </form>
      </dialog>
    )
  }
</Base>

<script>
  import { createModelViewer, loadModelViewer } from "../../lib/mesh-viewer";
  import { bindShareButtons, shareLink } from "../../lib/share";

  bindShareButtons();

  const dialog = document.querySelector<HTMLDialogElement>("#lightbox");
  const img = dialog?.querySelector("img");
  const meshLinks = dialog?.querySelector<HTMLElement>(".mesh-links");
  const caption = dialog?.querySelector<HTMLElement>(".caption");
  const thumbs = [...document.querySelectorAll<HTMLAnchorElement>(".thumb")];
  let current: HTMLAnchorElement | undefined;

  function showMesh(lightbox: HTMLDialogElement, still: HTMLImageElement, thumb: HTMLAnchorElement) {
    const mesh = thumb.dataset.mesh!;
    const alt = `3D mesh of ${thumb.dataset.alt ?? "this crungus"}`;
    still.hidden = true;
    still.after(createModelViewer(mesh, thumb.href, alt));
    if (meshLinks) {
      meshLinks.querySelector<HTMLAnchorElement>(".image-link")!.href = thumb.href;
      meshLinks.querySelector<HTMLAnchorElement>(".mesh-link")!.href = mesh;
      meshLinks.hidden = false;
    }
    lightbox.ariaLabel = "3D mesh";
    void loadModelViewer();
  }

  // the address always names the image on show, so it can be copied straight
  // from the address bar; replacing rather than pushing keeps Back for leaving
  function address(hash: string): void {
    history.replaceState(null, "", `${location.pathname}${location.search}${hash}`);
  }

  if (dialog && img) {
    function clear(lightbox: HTMLDialogElement, still: HTMLImageElement, keepStill = false): void {
      if (!keepStill) still.removeAttribute("src");
      still.hidden = false;
      lightbox.querySelector("model-viewer")?.remove();
      if (meshLinks) meshLinks.hidden = true;
      lightbox.ariaLabel = "full-size image";
    }

    // stepping holds the image on show until the next has decoded, so the
    // lightbox doesn't collapse and jump while it loads
    async function swapIn(still: HTMLImageElement, thumb: HTMLAnchorElement): Promise<void> {
      if (still.getAttribute("src")) {
        const next = new Image();
        next.src = thumb.href;
        await next.decode().catch(() => {});
        if (current !== thumb) return; // stepped on again meanwhile
      }
      still.src = thumb.href;
      still.alt = thumb.dataset.alt ?? "";
    }

    function open(lightbox: HTMLDialogElement, still: HTMLImageElement, thumb: HTMLAnchorElement): void {
      const hadMesh = lightbox.querySelector("model-viewer") !== null;
      clear(lightbox, still, !hadMesh && !thumb.dataset.mesh);
      current = thumb;
      if (thumb.dataset.mesh) {
        showMesh(lightbox, still, thumb);
      } else {
        void swapIn(still, thumb);
      }
      // the likely next step, fetched ahead
      const after = thumbs[(thumbs.indexOf(thumb) + 1) % thumbs.length];
      if (after && !after.dataset.mesh) new Image().src = after.href;
      if (caption) caption.textContent = thumb.dataset.caption ?? "";
      address(`#${thumb.id}`);
      if (!lightbox.open) lightbox.showModal();
    }

    function step(by: number): void {
      if (!current || !dialog || !img) return;
      const at = thumbs.indexOf(current);
      open(dialog, img, thumbs[(at + by + thumbs.length) % thumbs.length]!);
    }

    // an address naming an image opens it, on arrival or when the hash changes
    function openFromAddress(): void {
      const target = document.getElementById(decodeURIComponent(location.hash.slice(1)));
      if (dialog && img && target instanceof HTMLAnchorElement && thumbs.includes(target)) {
        open(dialog, img, target);
      }
    }

    for (const thumb of thumbs) {
      thumb.addEventListener("click", (event) => {
        // JS upgrades the plain full-size link into a dialog lightbox
        event.preventDefault();
        open(dialog, img, thumb);
      });
    }
    for (const button of dialog.querySelectorAll<HTMLButtonElement>(".step")) {
      button.addEventListener("click", () => step(Number(button.dataset.step)));
    }
    dialog.querySelector(".share-current")?.addEventListener("click", () => {
      if (current) void shareLink(`#${current.id}`, current.dataset.title ?? document.title);
    });
    // on the document, since a lightbox opened by the address on arrival may
    // not have the focus
    document.addEventListener("keydown", (event) => {
      if (!dialog.open || event.metaKey || event.ctrlKey || event.altKey) return;
      // the mesh viewer turns the model with the arrow keys
      if ((event.target as Element).closest("model-viewer")) return;
      if (event.key === "ArrowLeft") step(-1);
      else if (event.key === "ArrowRight") step(1);
    });
    dialog.addEventListener("close", () => {
      clear(dialog, img);
      // back on the page at the last image looked at, not the first one opened
      current?.focus();
      current?.scrollIntoView({ block: "nearest" });
      current = undefined;
      address("");
    });
    // light-dismiss fallback for browsers without closedby support
    if (!("closedBy" in HTMLDialogElement.prototype)) {
      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
      });
    }
    addEventListener("hashchange", openFromAddress);
    openFromAddress();
  }
</script>

<style>
  header {
    padding-block: 2rem 1rem;
    max-width: 46rem;
  }

  .eyebrow {
    margin: 0 0 0.5rem;
  }

  h1 {
    font-size: clamp(1.4rem, 4vw, 2.1rem);
    font-weight: 500;
    margin: 0 0 0.75rem;
    overflow-wrap: anywhere;
  }

  .description {
    margin: 0;
  }

  .notes {
    font-style: italic;
  }

  .prompt-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    border-block-end: 1px solid var(--line);
    margin: 2rem 0 1rem;
    padding-block-end: 0.4rem;
  }

  h2 {
    font-size: 1rem;
    font-weight: 500;
    margin: 0;
  }

  .refusals {
    margin: 0 0 1rem;
    padding: 0.5rem 0.75rem;
    border-inline-start: 3px solid var(--accent);
    background: var(--surface);
    /* --muted is 4.44:1 on --surface, just under AA; this is a finding rather
       than an aside, so it takes the body colour */
    color: var(--text);
    font-size: 0.85rem;
  }

  .refusals b {
    color: var(--accent-bright);
    font-weight: 500;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(170px, 44vw), 1fr));
    gap: 0.75rem;
  }

  .thumb {
    position: relative;
    display: block;
    padding: 0;
    background: var(--surface);
    cursor: zoom-in;
  }

  .mesh-badge {
    position: absolute;
    inset-block-start: 0.35rem;
    inset-inline-end: 0.35rem;
    /* above the cover image, whose view-transition-name stacks it */
    z-index: 1;
    padding: 0.05rem 0.4rem;
    background: var(--ground);
    border: 1px solid var(--accent);
    color: var(--accent-bright);
    font-size: 0.75rem;
  }

  .thumb img {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .clips {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(22rem, 100%), 1fr));
    gap: 0.5rem 1.5rem;
  }

  .clips li {
    display: grid;
    grid-template-columns: 2ch 1fr auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.25rem 0.4rem;
    border: 1px solid transparent;
    scroll-margin-block: 30vh;
  }

  /* the clip a permalink pointed at */
  .clips li:target {
    background: var(--surface);
    border-color: var(--accent);
  }

  dialog {
    background: var(--ground);
    border: 1px solid var(--line);
    padding: 0.75rem;
    max-width: min(92vw, 64rem);
  }

  dialog::backdrop {
    background: rgb(0 0 0 / 75%);
  }

  dialog img {
    max-width: 100%;
    max-height: 80vh;
    display: block;
  }

  dialog img[hidden] {
    display: none;
  }

  /* created by the script, so outside Astro's scoping */
  dialog :global(model-viewer) {
    display: block;
    width: min(88vw, 64rem);
    height: min(70vh, 64rem);
    background: var(--surface);
  }

  .lightbox-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-block-start: 0.6rem;
  }

  .caption {
    margin: 0;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  .actions {
    display: flex;
    gap: 0.4rem;
  }

  .mesh-links {
    margin: 0.6rem 0 0;
    color: var(--muted);
    font-size: 0.85rem;
  }

  dialog button {
    background: none;
    font: inherit;
    border: 1px solid var(--line);
    color: var(--muted);
    padding: 0.25rem 0.8rem;
    cursor: pointer;
  }

  dialog button:hover {
    color: var(--text);
  }
</style>
