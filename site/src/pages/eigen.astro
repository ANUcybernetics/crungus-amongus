---
import Base from "../layouts/Base.astro";
import { siteData } from "../lib/data";
import { generatedModels, imageCount } from "../lib/models";
import { path } from "../lib/paths";

const models = generatedModels(siteData, "image");
const imageTotal = models.reduce((n, m) => n + imageCount(m), 0);
const labels = Object.fromEntries(models.map((m) => [m.slug, `${m.owner}/${m.name}`]));
const modelBase = path("/model/");
const imageBase = siteData.image_base_url;
---

<Base
  title="Eigencrungi — Crungus Amongus"
  description="The archive decomposed eigenfaces-style: a mean crungus and the components it varies along, each on a slider."
>
  <section class="intro">
    <h1>The eigencrungi</h1>
    <p class="lede">
      In 1991 Turk and Pentland took a stack of face photographs, treated each one
      as a point in pixel space and found the directions the stack varied along
      most: the <em>eigenfaces</em>, from which any face could be rebuilt as a
      weighted sum. Here the same arithmetic is done to the archive:{" "}
      {imageTotal.toLocaleString("en-AU")}{" "}
      crungi, centre-cropped and shrunk to 128 pixels, no alignment. The stage
      starts on the mean crungus. Each slider is one direction, shown beside the
      archive's images at its two extremes; push it and see what it carries. Click
      any image to load its coefficients and see how much of it survives.
    </p>
    <p class="lede">
      The first slider is the odd one out. Rather than a direction the archive
      happened to vary along, it is the archive projected onto CLIP's reading of
      the word <em>crungus</em> — the one axis here that means what a
      crungus-ness slider should mean. The numbered components below it are
      unsupervised, and most of them are sampling noise: beside each is how well
      it reproduces when the archive is split in half and decomposed twice.
    </p>
  </section>

  <div class="lab" hidden>
    <div class="stage">
      <div class="pair">
        <figure>
          <canvas id="recon" width="128" height="128" aria-label="the reconstructed crungus"></canvas>
          <figcaption id="stage-caption" class="mono muted" aria-live="polite">
            the mean crungus
          </figcaption>
        </figure>
        <figure id="original" hidden>
          <img id="original-image" alt="" width="128" height="128" />
          <figcaption class="mono muted"><a id="original-link" href="#">the original</a></figcaption>
        </figure>
      </div>
      <p class="mono controls">
        <button id="reset" type="button">the mean crungus</button>
        <button id="random" type="button">a real crungus</button>
      </p>
    </div>
    <div class="axes">
      <div id="headline"></div>
      <ol id="components" class="components"></ol>
    </div>
  </div>

  <p id="loading" class="mono muted">loading the eigencrungi…</p>
  <noscript>
    <p class="muted">
      The sliders need JavaScript. The images they are built from are all in
      <a href={path()}>the archive</a>.
    </p>
  </noscript>

  <section class="notes">
    <p>
      Faces decompose neatly because they are aligned before the maths: eyes
      here, mouth there. Nothing aligns a crungus, so the leading components
      describe light, framing and palette before they describe a creature.
      Component 1 is not subtle about it: its coefficient correlates with a
      picture's mean brightness at r&nbsp;=&nbsp;0.9967, which makes the most
      reproducible axis in the archive a light meter. It is also the one most
      about the models rather than the creature: as an analysis of variance
      over which model drew each image, 54% of component 1's spread is
      explained by the model label alone, against 16% averaged across all
      twenty-four. Which model you asked matters most for how bright the
      picture came out.
    </p>
    <p>
      <b>Stability</b> beside each slider is how much of the direction survives
      a fresh draw: split the archive into disjoint halves, decompose both, and
      take the cosine between the two versions of that component, averaged over
      eight splits. One means the direction is a property of the archive; near
      zero means it is a property of this particular sample. Nineteen of the
      twenty-four clear 0.7 and thirteen clear 0.9. At a tenth of this many
      images only five did, and the collapse looked like a property of the
      spectrum — the eigenvalues past the fifth sit close enough together that
      the components seemed free to rotate whatever we did. That was wrong: it
      was sample size, and ten times the images bought fourteen more real axes.
      Only a component that clears 0.7 can be given a name; everything below it
      goes by number, however suggestive its extremes look. The crungus-ness
      axis sidesteps the question entirely — it is fixed by the prompt rather
      than estimated from the sample, so resampling cannot move it. More in
      <a href={path("/about/")}>about</a>.
    </p>
  </section>
</Base>

<script
  is:inline
  type="application/json"
  id="eigen-config"
  set:html={JSON.stringify({ labels, modelBase, imageBase })}
/>

<script>
  import {
    decodeSheet,
    modelSlug,
    reconstruct,
    sliders as sliderAxes,
    weightsFor,
    type EigenData,
    type Slider,
  } from "../lib/eigen";
  import { TileLoader, cellFinder, tileNames, type SpriteIndex } from "../lib/sprite";

  const config = JSON.parse(document.getElementById("eigen-config")!.textContent!) as {
    labels: Record<string, string>;
    modelBase: string;
    imageBase: string;
  };
  const lab = document.querySelector<HTMLElement>(".lab")!;
  const loading = document.getElementById("loading")!;
  const recon = document.getElementById("recon") as HTMLCanvasElement;
  const stageCaption = document.getElementById("stage-caption")!;
  const original = document.getElementById("original") as HTMLElement;
  const originalImage = document.getElementById("original-image") as HTMLImageElement;
  const originalLink = document.getElementById("original-link") as HTMLAnchorElement;
  const headline = document.getElementById("headline")!;
  const list = document.getElementById("components")!;

  async function loadImage(src: string): Promise<HTMLImageElement> {
    const image = new Image();
    image.crossOrigin = "anonymous"; // the sheet's pixels are read back
    image.src = src;
    await image.decode();
    return image;
  }

  const [data, sheet, spriteIndex] = await Promise.all([
    fetch(`${config.imageBase}/eigen/eigen.json`).then(
      (r) => r.json() as Promise<EigenData>,
    ),
    loadImage(`${config.imageBase}/eigen/eigen.webp`),
    fetch(`${config.imageBase}/atlas/sprite.json`).then(
      (r) => r.json() as Promise<SpriteIndex>,
    ),
  ]);

  const axes = sliderAxes(data);
  const side = data.side;
  const scratch = document.createElement("canvas");
  scratch.width = sheet.width;
  scratch.height = sheet.height;
  const scratchContext = scratch.getContext("2d", { willReadFrequently: true })!;
  scratchContext.drawImage(sheet, 0, 0);
  const decoded = decodeSheet(
    scratchContext.getImageData(0, 0, sheet.width, sheet.height).data,
    sheet.width,
    side,
    axes.map((slider) => slider.axis),
  );

  const reconContext = recon.getContext("2d")!;
  const frame = reconContext.createImageData(side, side);
  const weights = axes.map(() => 0);
  const inputs: HTMLInputElement[] = [];
  const outputs: HTMLOutputElement[] = [];
  const cellOf = cellFinder(spriteIndex);
  // exemplars are scattered across the corpus, so their tiles arrive as the
  // thumbnails ask for them and each one paints itself when its tile lands
  const pendingThumbnails = new Map<number, (() => void)[]>();
  const tiles = new TileLoader(
    tileNames(spriteIndex),
    `${config.imageBase}/atlas`,
    (loaded) => {
      for (const paint of pendingThumbnails.get(loaded) ?? []) paint();
      pendingThumbnails.delete(loaded);
    },
  );
  const keys = Object.keys(data.coefficients);
  const threshold = data.stability_threshold ?? 0.7;

  function labelFor(key: string): string {
    return config.labels[modelSlug(key)] ?? modelSlug(key);
  }

  function render() {
    reconstruct(
      decoded,
      axes.map((slider) => slider.axis),
      weights,
      frame.data,
    );
    reconContext.putImageData(frame, 0, 0);
  }

  function setWeight(j: number, value: number) {
    weights[j] = value;
    inputs[j]!.value = String(value);
    outputs[j]!.value = `${value >= 0 ? "+" : "−"}${Math.abs(value).toFixed(1)}σ`;
  }

  function showMean() {
    axes.forEach((_, j) => setWeight(j, 0));
    original.hidden = true;
    stageCaption.textContent = "the mean crungus";
    render();
  }

  function showImage(key: string) {
    weightsFor(data, key).forEach((value, j) => setWeight(j, value));
    originalImage.src = `${config.imageBase}/${key}`;
    originalImage.alt = `crungus by ${labelFor(key)}`;
    originalLink.href = `${config.modelBase}${modelSlug(key)}/`;
    originalLink.textContent = labelFor(key);
    original.hidden = false;
    stageCaption.textContent = `the same crungus as ${axes.length} numbers`;
    render();
  }

  function thumbnail(key: string): HTMLButtonElement {
    const button = document.createElement("button");
    button.type = "button";
    button.setAttribute("aria-label", `load the crungus by ${labelFor(key)}`);
    button.title = labelFor(key);
    const canvas = document.createElement("canvas");
    canvas.width = spriteIndex.cell_px;
    canvas.height = spriteIndex.cell_px;
    const cell = cellOf(key);
    if (cell !== undefined) {
      const paint = () => {
        const spriteTile = tiles.get(cell.tile);
        if (spriteTile === undefined) return false;
        canvas
          .getContext("2d")!
          .drawImage(
            spriteTile,
            cell.x,
            cell.y,
            spriteIndex.cell_px,
            spriteIndex.cell_px,
            0,
            0,
            spriteIndex.cell_px,
            spriteIndex.cell_px,
          );
        return true;
      };
      if (!paint()) {
        const waiting = pendingThumbnails.get(cell.tile) ?? [];
        waiting.push(paint);
        pendingThumbnails.set(cell.tile, waiting);
      }
    }
    button.append(canvas);
    button.addEventListener("click", () => showImage(key));
    return button;
  }

  /** One tile of the eigencrungi sheet, as its own canvas beside a slider. */
  function sheetTile(index: number): HTMLCanvasElement {
    const canvas = document.createElement("canvas");
    canvas.width = side;
    canvas.height = side;
    canvas.className = "tile";
    canvas.setAttribute("aria-hidden", "true");
    canvas
      .getContext("2d")!
      .drawImage(sheet, index * side, 0, side, side, 0, 0, side, side);
    return canvas;
  }

  /** The figures under a slider's heading: how big it is, and how well it holds. */
  function meta(slider: Slider, output: HTMLOutputElement): HTMLElement {
    const span = document.createElement("span");
    span.className = "mono muted";
    const stability = document.createElement("span");
    const held = slider.axis.stability ?? 0;
    stability.className = held > threshold ? "holds" : "noise";
    stability.title =
      held > threshold
        ? "this direction reproduces when the archive is resampled"
        : "a different draw of the archive would have rotated this direction away";
    if (slider.number === null) {
      span.append("supervised · ");
      stability.textContent = "fixed by the prompt";
    } else {
      const component = slider.axis as { variance?: number };
      span.append(`${((component.variance ?? 0) * 100).toFixed(1)}% · `);
      stability.textContent = `stability ${held.toFixed(2)}`;
    }
    span.append(stability, " · ", output);
    return span;
  }

  function row(slider: Slider, j: number, tag: "li" | "div"): HTMLElement {
    const item = document.createElement(tag);
    item.className = "component";
    if (slider.number !== null && (slider.axis.stability ?? 0) <= threshold) {
      item.classList.add("unstable");
    }
    const id = `axis-${j}`;
    const label = document.createElement("label");
    label.htmlFor = id;
    // a component past the stability threshold goes by number: a hand-name
    // there would be naming this draw of the archive rather than the archive
    label.innerHTML = slider.name
      ? `${slider.number === null ? "" : `<b class="mono">${slider.number}</b>`}${slider.name}`
      : `<span class="muted">component ${slider.number}</span>`;

    const output = document.createElement("output");
    output.htmlFor.add(id);
    const head = document.createElement("div");
    head.className = "head";
    head.append(label, meta(slider, output));

    const input = document.createElement("input");
    input.type = "range";
    input.id = id;
    input.min = "-3";
    input.max = "3";
    input.step = "0.05";
    input.value = "0";
    input.addEventListener("input", () => {
      setWeight(j, Number(input.value));
      original.hidden = true;
      stageCaption.textContent = "a crungus that never was";
      render();
    });

    const negatives = document.createElement("div");
    negatives.className = "exemplars";
    negatives.append(...slider.axis.negative.map(thumbnail));
    const positives = document.createElement("div");
    positives.className = "exemplars";
    positives.append(...slider.axis.positive.map(thumbnail));
    const controls = document.createElement("div");
    controls.className = "row";
    controls.append(negatives, input, positives);

    item.append(sheetTile(slider.axis.tile), head, controls);
    inputs.push(input);
    outputs.push(output);
    return item;
  }

  axes.forEach((slider, j) => {
    if (slider.number === null) {
      headline.append(row(slider, j, "div"));
    } else {
      list.append(row(slider, j, "li"));
    }
  });

  document.getElementById("reset")!.addEventListener("click", showMean);
  document.getElementById("random")!.addEventListener("click", () => {
    showImage(keys[Math.floor(Math.random() * keys.length)]!);
  });

  showMean();
  loading.hidden = true;
  lab.hidden = false;
</script>

<style>
  .intro {
    padding-block: 2rem 1rem;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 2.8rem);
    margin: 0 0 0.75rem;
  }

  .lede {
    max-width: 46rem;
    margin: 0 0 1.5rem;
  }

  .lab {
    display: grid;
    grid-template-columns: minmax(14rem, 20rem) 1fr;
    gap: 2rem 3rem;
    align-items: start;
    margin-block-end: 2rem;
  }

  .lab[hidden] {
    display: none;
  }

  @media (width <= 56rem) {
    .lab {
      grid-template-columns: 1fr;
    }
  }

  .stage {
    position: sticky;
    top: 1rem;
  }

  .pair {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }

  /* a loaded original sits beside its reconstruction, not under it */
  .pair:has(#original:not([hidden])) {
    grid-template-columns: 1fr 1fr;
  }

  .stage figure {
    margin: 0;
  }

  .stage canvas,
  .stage img {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .stage figcaption {
    margin: 0.4rem 0 0;
    min-height: 1.4em;
  }

  @media (width <= 56rem) {
    .stage {
      top: 0;
      z-index: 1;
      background: var(--ground);
      padding-block: 0.5rem;
    }

    .pair {
      max-width: 20rem;
    }
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.75rem 0 0;
  }

  .controls button {
    background: none;
    border: 1px solid var(--line);
    color: var(--muted);
    font: inherit;
    padding: 0.25rem 0.7rem;
    cursor: pointer;
  }

  .controls button:hover {
    color: var(--ground);
    background: var(--accent);
    border-color: var(--accent);
  }

  .axes {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }

  /* the supervised axis leads, set apart from the numbered components */
  #headline :global(.component) {
    border: 1px solid var(--accent);
    border-inline-start-width: 3px;
    padding: 0.75rem;
  }

  #headline :global(label) {
    font-size: 1.1rem;
  }

  .components {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.25rem;
  }

  .axes :global(.component) {
    display: grid;
    grid-template-columns: 4rem 1fr;
    grid-template-rows: auto auto;
    gap: 0.4rem 1rem;
    align-items: center;
    border-block-end: 1px solid var(--line);
    padding-block-end: 1.25rem;
  }

  .axes :global(.tile) {
    grid-row: 1 / 3;
    width: 4rem;
    aspect-ratio: 1;
    display: block;
    border: 1px solid var(--line);
  }

  .axes :global(.head) {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .axes :global(label b) {
    color: var(--accent-bright);
    font-weight: 500;
    margin-inline-end: 0.35rem;
  }

  .axes :global(.row) {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.6rem;
    align-items: center;
  }

  .axes :global(.exemplars) {
    display: flex;
    gap: 0.25rem;
  }

  .axes :global(.exemplars button) {
    padding: 0;
    border: 1px solid var(--line);
    background: none;
    cursor: pointer;
    line-height: 0;
  }

  .axes :global(.exemplars button:hover) {
    border-color: var(--accent-bright);
  }

  .axes :global(.exemplars canvas) {
    display: block;
    width: 2.5rem;
    height: 2.5rem;
  }

  .axes :global(input[type="range"]) {
    width: 100%;
    margin: 0;
    accent-color: var(--accent);
  }

  @media (width <= 40rem) {
    .axes :global(.row) {
      grid-template-columns: 1fr 1fr;
    }

    .axes :global(input[type="range"]) {
      grid-column: 1 / 3;
      grid-row: 2;
    }

    .axes :global(.exemplars:last-child) {
      justify-content: end;
    }
  }

  /* an unstable component is still shown, just not dressed up as a finding */
  .axes :global(.component.unstable .tile) {
    opacity: 0.55;
  }

  .axes :global(.holds) {
    color: var(--accent-bright);
  }

  #loading[hidden] {
    display: none;
  }

  .notes {
    max-width: 46rem;
    margin-block-end: 2rem;
  }
</style>
