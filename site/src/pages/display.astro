---
import Base from "../layouts/Base.astro";
import { siteData } from "../lib/data";
import { generatedModels } from "../lib/models";
import { path } from "../lib/paths";

const models = generatedModels(siteData, "image");
---

<Base
  title="Display — Crungus Amongus"
  description="A wall of crungus images from across the archive, or one at a time, with crungus radio playing over it on request."
  bare
>
  <div
    class="stage"
    id="stage"
    tabindex="-1"
    data-tiles={path("/display/tiles.json")}
    data-audio={path("/api/audio.json")}
    data-models={path("/api/models.json")}
    data-model-base={path("/model/")}
  >
    <div class="wall" id="wall"></div>
    <noscript>
      <p class="mono">
        The display needs JavaScript. Every image is also in the <a href={path()}>archive</a>.
      </p>
    </noscript>
    <div class="bar">
      <div class="status mono">
        <a class="home" href={path()}>crungus amongus</a>
        <p id="now-playing" aria-live="polite"></p>
      </div>
      <p class="controls mono">
        <select id="model" aria-label="models shown">
          <option value="">all models</option>
          {models.map((m) => <option value={m.slug}>{m.owner}/{m.name}</option>)}
        </select>
        <button id="single" type="button" aria-pressed="false">single</button>
        <button id="radio" type="button" aria-pressed="false">radio</button>
        <button id="skip" type="button" hidden>next</button>
        <button id="full" type="button" hidden>fullscreen</button>
        <button type="button" popovertarget="help" aria-label="about the display">?</button>
      </p>
    </div>
    <div id="help" class="help" popover>
      <h1>Crungus display</h1>
      <p>
        A wall of images drawn at random from the <a href={path()}>archive</a>, or from a single
        model, with one tile replaced every second, or one image at a time in single mode. Turn on
        the radio to hear every clip in the <a href={path("/sound/")}>sound archive</a>, shuffled
        and played end to end.
      </p>
      <p class="mono muted">
        f fullscreen · s single/grid · + − tile size · r radio · n next clip · add
        <code>?model=…</code>, <code>?single</code>, <code>?tile=…</code> (pixels) or
        <code>?radio</code> to the address to set the display up from it
      </p>
      <p class="mono"><a href={path("/about/")}>about the project</a></p>
    </div>
    <div class="progress" id="progress" aria-hidden="true" hidden><span></span></div>
    <audio class="player" preload="none"></audio>
    <audio class="player" preload="none"></audio>
  </div>
</Base>

<script>
  import { shuffleBag, tilesFor } from "../lib/mosaic";
  import type { MosaicData, Tile } from "../lib/mosaic";
  import type { ApiClip } from "../lib/api";

  const SWAP_MS = 1000;
  const SINGLE_MS = 7000;
  const FADE_MS = 600;
  const CROSSFADE_MS = 1000;
  const IDLE_MS = 2500;
  const TILE_STEP = 1.25;
  const MIN_TILE_PX = 60;

  async function hang(stage: HTMLElement): Promise<void> {
    const wall = document.getElementById("wall")!;
    const bar = stage.querySelector<HTMLElement>(".bar")!;
    const picker = document.getElementById("model") as HTMLSelectElement;
    const singleButton = document.getElementById("single") as HTMLButtonElement;
    const radio = document.getElementById("radio") as HTMLButtonElement;
    const skip = document.getElementById("skip") as HTMLButtonElement;
    const full = document.getElementById("full") as HTMLButtonElement;
    const players = [...stage.querySelectorAll<HTMLAudioElement>(".player")];
    const nowPlaying = document.getElementById("now-playing")!;
    const progress = document.getElementById("progress")!;
    const { tiles: tilesUrl, audio: audioUrl, models: modelsUrl, modelBase } = stage.dataset;

    const params = new URLSearchParams(location.search);
    const still = matchMedia("(prefers-reduced-motion: reduce)");

    const data = (await (await fetch(tilesUrl!)).json()) as MosaicData;
    if (data.models.length === 0) return;

    // --- the wall
    picker.value = params.get("model") ?? "";
    let nextTile = shuffleBag(tilesFor(data, picker.value));
    let nextSlot: (() => HTMLAnchorElement) | undefined;
    let single = params.has("single");
    const tileParam = Number(params.get("tile"));
    let tilePx = tileParam >= MIN_TILE_PX ? tileParam : undefined;

    // the incoming image decodes off-screen, then fades in over the old one
    async function show(slot: HTMLAnchorElement, tile: Tile): Promise<void> {
      const wasSingle = single;
      const image = new Image();
      image.alt = "";
      if (single) image.src = tile.full;
      else {
        // the browser picks the thumbnail that suits the tile and the display's density
        image.sizes = `${slot.clientWidth}px`;
        image.srcset = tile.srcset;
      }
      try {
        await image.decode();
      } catch {
        return; // a missing image just holds the current one
      }
      // the mode changed while it was loading, and the slot with it
      if (single !== wasSingle || !slot.isConnected) return;
      const frame = document.createElement("span");
      frame.className = "frame";
      if (single) {
        // the same image, blurred, fills whatever the letterbox leaves
        const backdrop = new Image();
        backdrop.alt = "";
        backdrop.className = "backdrop";
        backdrop.sizes = "240px";
        backdrop.srcset = tile.srcset;
        frame.append(backdrop);
      }
      const caption = document.createElement("span");
      caption.className = "caption mono";
      const name = document.createElement("span");
      name.textContent = tile.model.name;
      const prompt = document.createElement("span");
      prompt.textContent = tile.prompt;
      caption.append(name, prompt);

      frame.append(image, caption);
      slot.href = tile.page;
      slot.append(frame);
      await frame.animate([{ opacity: 0 }, { opacity: 1 }], {
        duration: still.matches ? 0 : FADE_MS,
      }).finished;
      while (frame.previousElementSibling) frame.previousElementSibling.remove();
    }

    // the stylesheet chooses the grid; this fills however many cells it made.
    // Surplus tiles spill into implicit rows, which the resolved value lists
    // too, so those rows are zero-height and left out of the count
    function layOut(): void {
      const style = getComputedStyle(wall);
      const cols = style.gridTemplateColumns.split(" ").length;
      const rows = style.gridTemplateRows.split(" ").filter((track) => track !== "0px").length;
      const count = cols * rows;
      if (count === wall.childElementCount) return;
      while (wall.childElementCount > count) wall.lastElementChild!.remove();
      while (wall.childElementCount < count) {
        const slot = document.createElement("a");
        slot.className = "tile";
        wall.append(slot);
        void show(slot, nextTile());
      }
      nextSlot = shuffleBag([...wall.children] as HTMLAnchorElement[]);
    }

    let swapTimer: number | undefined;
    function swap(): void {
      if (!document.hidden && nextSlot) void show(nextSlot(), nextTile());
      swapTimer = window.setTimeout(swap, single ? SINGLE_MS : SWAP_MS);
    }

    function setSingle(on: boolean): void {
      single = on;
      wall.classList.toggle("single", on);
      singleButton.setAttribute("aria-pressed", String(on));
      wall.replaceChildren();
      layOut();
      window.clearTimeout(swapTimer);
      swapTimer = window.setTimeout(swap, single ? SINGLE_MS : SWAP_MS);
    }

    function setTile(px: number | undefined): void {
      tilePx = px;
      if (px) wall.style.setProperty("--tile", `${px}px`);
      else wall.style.removeProperty("--tile");
      layOut();
    }

    // bigger or smaller by a step from the tiles as they are, never past one
    // tile filling the stage's short side
    function stepTile(factor: number): void {
      if (single) return;
      const current = tilePx ?? (wall.firstElementChild as HTMLElement).clientWidth;
      const limit = Math.min(wall.clientWidth, wall.clientHeight);
      setTile(Math.round(Math.min(limit, Math.max(MIN_TILE_PX, current * factor))));
      writeAddress();
    }

    setTile(tilePx);
    setSingle(single);
    new ResizeObserver(layOut).observe(wall);

    // --- the address carries the setup, so a display can be pointed straight at it
    let onAir = false;
    function writeAddress(): void {
      const url = new URL(location.href);
      if (picker.value) url.searchParams.set("model", picker.value);
      else url.searchParams.delete("model");
      if (single) url.searchParams.set("single", "");
      else url.searchParams.delete("single");
      if (tilePx) url.searchParams.set("tile", String(tilePx));
      else url.searchParams.delete("tile");
      if (onAir) url.searchParams.set("radio", "");
      else url.searchParams.delete("radio");
      history.replaceState(null, "", url);
    }

    picker.addEventListener("change", () => {
      nextTile = shuffleBag(tilesFor(data, picker.value));
      for (const slot of wall.children) void show(slot as HTMLAnchorElement, nextTile());
      writeAddress();
    });

    // --- radio: fetched from the JSON API the first time it is switched on
    let nextClip: (() => ApiClip) | undefined;
    let clipCount = 0;
    let labels = new Map<string, string>();
    // opus everywhere it plays; Safari on macOS gets the AAC fallback
    const canOpus = players[0].canPlayType('audio/ogg; codecs="opus"') !== "";
    // the two players take turns: each clip starts on the idle one and fades
    // in as the other fades out. Volume is read-only on iOS, where the two
    // just overlap for the crossfade
    let player = players[0];
    let fading = false;
    const fades = new Map<HTMLAudioElement, number>();

    function fade(element: HTMLAudioElement, to: number, then?: () => void): void {
      window.clearInterval(fades.get(element));
      const from = element.volume;
      const start = performance.now();
      const duration = still.matches ? 0 : CROSSFADE_MS;
      fades.set(
        element,
        window.setInterval(() => {
          const t = duration ? Math.min(1, (performance.now() - start) / duration) : 1;
          element.volume = from + (to - from) * t;
          if (t < 1) return;
          window.clearInterval(fades.get(element));
          then?.();
        }, 20),
      );
    }

    function silence(): void {
      for (const element of players) {
        window.clearInterval(fades.get(element));
        element.pause();
      }
    }

    // a line along the foot of the stage, outlasting the bar when it fades,
    // shows how far through the current clip the radio is
    function trackProgress(): void {
      progress.hidden = !onAir;
      if (!onAir) return;
      const done = player.duration > 0 ? player.currentTime / player.duration : 0;
      progress.style.setProperty("--done", String(done));
      requestAnimationFrame(trackProgress);
    }

    function setOnAir(on: boolean): void {
      const starting = on && !onAir;
      onAir = on;
      if (starting) requestAnimationFrame(trackProgress);
      radio.setAttribute("aria-pressed", String(on));
      skip.hidden = !on;
      if (!on) nowPlaying.textContent = "";
    }

    function play(clip: ApiClip): void {
      const label = labels.get(clip.model) ?? clip.model;
      const outgoing = player;
      player = players.find((element) => element !== outgoing)!;
      fading = false;
      fade(outgoing, 0, () => outgoing.pause());
      player.volume = 0;
      player.src = canOpus ? clip.opus : clip.m4a;
      fade(player, 1);
      player.play().catch((error: unknown) => {
        if (error instanceof DOMException && error.name === "NotAllowedError") awaitGesture();
      });
      nowPlaying.replaceChildren("now playing · ");
      const model = document.createElement("a");
      model.href = `${modelBase}${clip.model}/`;
      model.textContent = label;
      // the clip's own permalink, kept on this host so it works off the live site too
      const page = new URL(clip.page);
      const link = document.createElement("a");
      link.href = page.pathname + page.hash;
      link.textContent = `“${clip.prompt}” #${page.hash.split("-").at(-1)}`;
      nowPlaying.append(model, " · ", link);
      if ("mediaSession" in navigator) {
        navigator.mediaSession.metadata = new MediaMetadata({
          title: `“${clip.prompt}”`,
          artist: label,
          album: "crungus radio",
        });
      }
    }

    // a browser that refuses to start sound unprompted gets it on the first
    // click or key press instead; the address keeps asking for the radio
    function awaitGesture(): void {
      setOnAir(false);
      nowPlaying.textContent = "click anywhere to start the radio";
      const start = (event: Event): void => {
        document.removeEventListener("click", start, true);
        document.removeEventListener("keydown", start);
        if (onAir || event.target === radio) return;
        // that click starts the radio rather than following a tile's link
        if (event.type === "click" && wall.contains(event.target as Node)) event.preventDefault();
        void tuneIn();
      };
      document.addEventListener("click", start, true);
      document.addEventListener("keydown", start);
    }

    async function tuneIn(): Promise<void> {
      setOnAir(true);
      if (!nextClip) {
        const [audio, index] = (await Promise.all(
          [audioUrl!, modelsUrl!].map(async (url) => (await fetch(url)).json()),
        )) as [{ clips: ApiClip[] }, { models: { slug: string; owner: string; name: string }[] }];
        if (audio.clips.length === 0) {
          setOnAir(false);
          radio.hidden = true;
          return;
        }
        labels = new Map(index.models.map((m) => [m.slug, `${m.owner}/${m.name}`]));
        clipCount = audio.clips.length;
        nextClip = shuffleBag(audio.clips);
      }
      if (onAir) play(nextClip());
    }
    function toggleRadio(): void {
      if (onAir) {
        silence();
        setOnAir(false);
      } else void tuneIn();
      writeAddress();
    }
    function skipClip(): void {
      if (onAir && nextClip) play(nextClip());
    }

    // the next clip starts a crossfade before this one ends; "ended" covers a
    // clip too short to fade or one whose duration never resolved
    let failures = 0;
    for (const element of players) {
      element.addEventListener("timeupdate", () => {
        const lead = CROSSFADE_MS / 1000;
        if (element !== player || fading || !(element.duration > 2 * lead)) return;
        if (element.duration - element.currentTime > lead) return;
        fading = true;
        failures = 0;
        skipClip();
      });
      element.addEventListener("ended", () => {
        if (element !== player) return;
        failures = 0;
        skipClip();
      });
      element.addEventListener("error", () => {
        if (element !== player) return;
        // skip a clip that won't load, but don't spin forever if none will
        failures += 1;
        if (failures < clipCount) skipClip();
        else setOnAir(false);
      });
    }

    function toggleSingle(): void {
      setSingle(!single);
      writeAddress();
    }
    singleButton.addEventListener("click", toggleSingle);
    radio.addEventListener("click", toggleRadio);
    skip.addEventListener("click", skipClip);
    if ("mediaSession" in navigator) {
      navigator.mediaSession.setActionHandler("nexttrack", skipClip);
    }

    // --- fullscreen
    function toggleFullscreen(): void {
      if (document.fullscreenElement) void document.exitFullscreen();
      else void stage.requestFullscreen().catch(() => {});
    }
    full.hidden = !document.fullscreenEnabled;
    full.addEventListener("click", toggleFullscreen);

    document.addEventListener("keydown", (event) => {
      if (event.target instanceof HTMLSelectElement) return; // the picker's type-ahead
      if (event.metaKey || event.ctrlKey || event.altKey) return;
      if (event.key === "f") toggleFullscreen();
      else if (event.key === "r") toggleRadio();
      else if (event.key === "n") skipClip();
      else if (event.key === "s") toggleSingle();
      else if (event.key === "+" || event.key === "=") stepTile(TILE_STEP);
      else if (event.key === "-") stepTile(1 / TILE_STEP);
    });

    // the bar fades once the pointer has been still for a while
    let idleTimer: number | undefined;
    function wake(): void {
      stage.classList.remove("idle");
      window.clearTimeout(idleTimer);
      idleTimer = window.setTimeout(() => stage.classList.add("idle"), IDLE_MS);
    }
    stage.addEventListener("pointermove", wake);
    bar.addEventListener("focusin", wake);
    wake();

    if (params.has("radio")) void tuneIn();
  }

  const stage = document.getElementById("stage");
  if (stage) void hang(stage);
</script>

<style>
  .stage {
    position: fixed;
    inset: 0;
    background: #000;
    overflow: hidden;
    outline: none;
    container-type: size;
  }

  .stage.idle {
    cursor: none;
  }

  /* as many tiles of about --tile as fit each way, stretched to fill the stage:
   * 200px by default, but never more than nine or fewer than two across its
   * short side, so a 4K panel at 1x gets 16 × 9 and a phone gets 2 × 4 */
  .wall {
    --track: minmax(var(--tile, clamp(100cqmin / 9, 200px, 100cqmin / 2)), 1fr);

    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, var(--track));
    grid-template-rows: repeat(auto-fill, var(--track));
    grid-auto-rows: 0;
  }

  .wall.single {
    grid-template: 1fr / 1fr;
  }

  /* tiles are built by the script, so they carry no scope attribute */
  .wall :global(.tile) {
    position: relative;
    display: block;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    container-type: inline-size;
    color: var(--text);
    text-decoration: none;
  }

  .wall :global(:is(.frame, .tile img)) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .wall.single :global(.frame img:not(.backdrop)) {
    object-fit: contain;
  }

  .wall :global(.backdrop) {
    filter: blur(2rem) brightness(0.5);
    scale: 1.15;
  }

  .wall :global(.caption) {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    padding: 12cqw 4cqw 3cqw;
    font-size: clamp(0.4rem, 6cqw, 0.9rem);
    line-height: 1.25;
    background: linear-gradient(transparent, rgb(0 0 0 / 70%));
  }

  /* at the top, clear of the control bar */
  .wall.single :global(.caption) {
    inset-block: 0 auto;
    padding: 1.5rem 2rem 4rem;
    font-size: clamp(0.9rem, 1.5cqw, 2rem);
    background: linear-gradient(rgb(0 0 0 / 70%), transparent);
  }

  .wall :global(.caption span) {
    display: block;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .wall :global(.caption span + span) {
    opacity: 0.7;
  }

  .bar {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    padding: 2.5rem 1rem 0.9rem;
    background: linear-gradient(transparent, rgb(0 0 0 / 85%));
    transition: opacity 0.4s ease;
  }

  .progress {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    height: 3px;
    background: rgb(255 255 255 / 12%);
  }

  .progress[hidden] {
    display: none;
  }

  .progress span {
    display: block;
    height: 100%;
    background: var(--accent);
    transform: scaleX(var(--done, 0));
    transform-origin: left;
  }

  .stage.idle .bar:not(:focus-within) {
    opacity: 0;
  }

  .bar p {
    margin: 0;
    color: var(--text);
  }

  .status {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    align-items: baseline;
  }

  .home {
    color: var(--muted);
    text-decoration: none;
    text-transform: uppercase;
  }

  .home:hover {
    color: var(--accent-bright);
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-inline-start: auto;
  }

  .controls :is(button, select) {
    background: rgb(0 0 0 / 55%);
    border: 1px solid var(--line);
    color: var(--text);
    font: inherit;
    padding: 0.3rem 0.8rem;
    cursor: pointer;
  }

  .controls select {
    max-width: 16rem;
  }

  .controls :is(button, select):hover {
    color: var(--accent-bright);
    border-color: var(--accent);
  }

  .controls button[aria-pressed="true"] {
    color: var(--ground);
    background: var(--accent);
    border-color: var(--accent);
  }

  .help {
    max-width: min(40rem, 100% - 2rem);
    padding: 1.5rem 1.75rem;
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--line);
  }

  .help::backdrop {
    background: rgb(0 0 0 / 50%);
  }

  .help h1 {
    font-size: 1.6rem;
    margin: 0 0 0.75rem;
  }

  noscript p {
    position: absolute;
    inset: 40% 1rem auto;
    text-align: center;
  }
</style>
