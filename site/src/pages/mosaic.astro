---
import { path } from "../lib/paths";

const target = path("/display/");
---

<!-- the display's old address: screens pointed here keep their setup, which a
     config redirect would drop along with the query string -->
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Display — Crungus Amongus</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={target} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <script is:inline define:vars={{ target }}>
      location.replace(target + location.search);
    </script>
  </head>
  <body>
    <p>The mosaic is now the <a href={target}>display</a>.</p>
  </body>
</html>
