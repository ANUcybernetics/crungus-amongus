---
// Crungus-ness: mean pairwise CLIP (images) or CLAP (clips) similarity of
// the model's ten outputs. High = the model summons one stable creature;
// low = ten unrelated guesses. The low/high bands are set per modality from
// the spread of the archive's own scores.
import type { Modality } from "../lib/schema";

interface Props {
  value: number | null;
  label?: string;
  modality?: Modality;
}

const { value, label = "consistency", modality = "image" } = Astro.props;
const bands = { image: { low: 0.55, high: 0.75 }, audio: { low: 0.65, high: 0.85 } }[modality];
const embedding = modality === "audio" ? "CLAP" : "CLIP";
---

{
  value !== null && (
    <span
      class="consistency mono"
      title={`mean pairwise ${embedding} similarity of this model's outputs`}
    >
      <span class="muted">{label}</span>
      <meter min="0" max="1" low={bands.low} high={bands.high} optimum={0.99} value={value} />
      <span>{value.toFixed(2)}</span>
    </span>
  )
}

<style>
  .consistency {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
  }

  meter {
    width: 4.5rem;
    height: 0.5rem;

    /* firefox */
    background: var(--surface-raised);
    border: none;
  }

  meter::-webkit-meter-bar {
    background: var(--surface-raised);
    border: none;
    border-radius: 0;
    height: 0.5rem;
  }

  meter::-webkit-meter-optimum-value,
  meter::-webkit-meter-suboptimum-value,
  meter::-webkit-meter-even-less-good-value {
    background: var(--accent);
  }

  meter::-moz-meter-bar {
    background: var(--accent);
  }
</style>
