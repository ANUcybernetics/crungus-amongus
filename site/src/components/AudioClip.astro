---
// A player in the site's own voice: a play button, a seek bar and a mono
// timecode. The <audio> underneath has two sources: the browser plays Opus
// where it can (everything but Safari on macOS, which only takes Opus in CAF)
// and falls back to AAC. Nothing is fetched until the listener presses play,
// unless the page asks for metadata. Without JavaScript the custom element
// never upgrades, and the browser's own controls stay in its place.
import { bucketUrl } from "../lib/images";
import type { ClipRef } from "../lib/schema";

interface Props {
  clip: ClipRef;
  label: string;
  preload?: "none" | "metadata";
}

const { clip, label, preload = "none" } = Astro.props;
---

<audio-clip>
  <audio controls preload={preload} aria-label={label}>
    <source src={bucketUrl(clip.opus)} type="audio/ogg; codecs=opus" />
    <source src={bucketUrl(clip.m4a)} type="audio/mp4" />
  </audio>
  <span class="player" hidden>
    <button type="button" class="toggle" aria-label={`play ${label}`} data-label={label}></button>
    <input
      type="range"
      class="seek"
      min="0"
      max="1000"
      step="1"
      value="0"
      aria-label={`position in ${label}`}
      disabled
    />
    <span class="time mono" aria-hidden="true">0:00 / –:––</span>
  </span>
</audio-clip>

<script>
  const clock = (seconds: number): string => {
    if (!Number.isFinite(seconds)) return "–:––";
    const whole = Math.floor(seconds);
    return `${Math.floor(whole / 60)}:${String(whole % 60).padStart(2, "0")}`;
  };

  class AudioClip extends HTMLElement {
    connectedCallback() {
      const audio = this.querySelector("audio")!;
      const player = this.querySelector<HTMLElement>(".player")!;
      const toggle = this.querySelector<HTMLButtonElement>(".toggle")!;
      const seek = this.querySelector<HTMLInputElement>(".seek")!;
      const time = this.querySelector<HTMLElement>(".time")!;
      const label = toggle.dataset.label ?? "";

      audio.controls = false;
      player.hidden = false;

      const render = () => {
        const { currentTime, duration } = audio;
        const known = Number.isFinite(duration) && duration > 0;
        seek.disabled = !known;
        seek.value = known ? String(Math.round((currentTime / duration) * 1000)) : "0";
        seek.style.setProperty("--progress", known ? `${(currentTime / duration) * 100}%` : "0%");
        time.textContent = `${clock(currentTime)} / ${clock(duration)}`;
      };

      const state = () => {
        const playing = !audio.paused;
        this.toggleAttribute("playing", playing);
        toggle.setAttribute("aria-label", `${playing ? "pause" : "play"} ${label}`);
      };

      toggle.addEventListener("click", () => {
        if (audio.paused) void audio.play();
        else audio.pause();
      });
      seek.addEventListener("input", () => {
        if (Number.isFinite(audio.duration))
          audio.currentTime = (Number(seek.value) / 1000) * audio.duration;
      });

      // one clip at a time: starting this one stops any other on the page
      audio.addEventListener("play", () => {
        for (const other of document.querySelectorAll<HTMLAudioElement>("audio-clip audio")) {
          if (other !== audio) other.pause();
        }
      });
      for (const event of ["play", "pause", "ended"]) audio.addEventListener(event, state);
      for (const event of ["timeupdate", "loadedmetadata", "durationchange", "emptied"]) {
        audio.addEventListener(event, render);
      }
      render();
    }
  }

  customElements.define("audio-clip", AudioClip);
</script>

<style>
  audio-clip {
    display: block;
    width: 100%;
  }

  audio {
    display: block;
    width: 100%;
    height: 2.25rem;
  }

  .player:not([hidden]) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: 2.25rem;
  }

  /* a ring in the muted line colour; the glyph inside is drawn, so it needs
     no font and sits exactly centred */
  .toggle {
    flex: none;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    background: none;
    border: 1px solid var(--muted);
    border-radius: 50%;
    color: var(--text);
    cursor: pointer;
  }

  .toggle::before {
    content: "";
    width: 0.65rem;
    height: 0.7rem;
    margin-inline-start: 0.15rem;
    background: currentcolor;
    clip-path: polygon(0 0, 100% 50%, 0 100%);
  }

  /* two bars while playing */
  audio-clip[playing] .toggle::before {
    width: 0.55rem;
    margin-inline-start: 0;
    background: none;
    border-inline: 0.18rem solid currentcolor;
    clip-path: none;
  }

  .toggle:hover {
    border-color: var(--hover);
    color: var(--hover);
  }

  /* a hairline track that fills in bone as the clip plays */
  .seek {
    flex: 1;
    min-width: 3rem;
    height: 1rem;
    margin: 0;
    background: none;
    appearance: none;
    cursor: pointer;
  }

  .seek:disabled {
    cursor: default;
  }

  .seek::-webkit-slider-runnable-track {
    height: 2px;
    background: linear-gradient(
      to right,
      var(--text) var(--progress, 0%),
      var(--line) var(--progress, 0%)
    );
  }

  .seek::-moz-range-track {
    height: 2px;
    background: linear-gradient(
      to right,
      var(--text) var(--progress, 0%),
      var(--line) var(--progress, 0%)
    );
  }

  .seek::-webkit-slider-thumb {
    width: 0.6rem;
    height: 0.6rem;
    margin-top: calc(1px - 0.3rem);
    border: none;
    border-radius: 50%;
    background: var(--text);
    appearance: none;
  }

  .seek::-moz-range-thumb {
    width: 0.6rem;
    height: 0.6rem;
    border: none;
    border-radius: 50%;
    background: var(--text);
  }

  /* no thumb until there is somewhere to seek to */
  .seek:disabled::-webkit-slider-thumb {
    visibility: hidden;
  }

  .seek:disabled::-moz-range-thumb {
    visibility: hidden;
  }

  .time {
    flex: none;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
</style>
