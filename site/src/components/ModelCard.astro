---
import { Image } from "astro:assets";

import { localImage } from "../lib/images";
import { coverImage, crungusness, releaseYear } from "../lib/models";
import type { ModelEntry } from "../lib/schema";
import ConsistencyMeter from "./ConsistencyMeter.astro";
import { path } from "../lib/paths";

interface Props {
  model: ModelEntry;
}

const { model } = Astro.props;
const cover = coverImage(model);
const image = cover ? localImage(cover) : null;
const score = crungusness(model);
---

<article class="card">
  <a href={path(`/model/${model.slug}/`)}>
    {
      image ? (
        <Image
          src={image}
          alt={`crungus as rendered by ${model.owner}/${model.name}`}
          format="avif"
          widths={[240, 480]}
          sizes="(max-width: 40rem) 44vw, 240px"
          style={`view-transition-name: cover-${model.slug}`}
        />
      ) : (
        <div class="no-image mono muted">no output</div>
      )
    }
    <h3 class="caption-label">{model.owner}/<wbr />{model.name}</h3>
  </a>
  <p class="meta mono muted">
    <span class="caption-note">{releaseYear(model)}</span>
    <ConsistencyMeter value={score} label="" />
  </p>
</article>

<style>
  .card a {
    display: block;
    color: var(--text);
    text-decoration: none;
  }

  .card img,
  .no-image {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    background: var(--surface);
    display: block;
  }

  .no-image {
    display: grid;
    place-items: center;
  }

  .card h3 {
    margin: 0.5rem 0 0.15rem;
    overflow-wrap: anywhere;
  }

  .card a:hover h3 {
    color: var(--hover);
  }

  /* held back, as the bestiary gallery holds its plates, and given their
     colour back on hover */
  .card img {
    filter: saturate(0.45) contrast(0.95);
    transition: filter 0.6s ease;
  }

  .card a:is(:hover, :focus-visible) img {
    filter: none;
  }

  .meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
  }
</style>
