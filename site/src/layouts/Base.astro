---
import "@fontsource/manrope/200.css";
import "@fontsource/manrope/300.css";
import "@fontsource/manrope/500.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../styles/global.css";
import { getImage } from "astro:assets";

import { siteData } from "../lib/data";
import { bucketUrl, imageRef } from "../lib/images";
import { generatedModels, meshedImages, timelineSample } from "../lib/models";
import { path } from "../lib/paths";

const TRAILING_SLASH = /\/$/;

type Section = "images" | "sound" | "video" | "meshes" | "atlas" | "eigen" | "display" | "about";

interface Props {
  title: string;
  description: string;
  // for pages whose address doesn't say, like a model's
  section?: Section;
  // no header or footer: the page has the whole window
  bare?: boolean;
  // corpus key of the image a shared link previews with
  image?: string | null;
  // the wordmark's o carries the rest of the name, folded away, for the page
  // to open (see .fold below); otherwise the name is set in full
  unfold?: boolean;
}

const { title, description, bare = false, unfold = false } = Astro.props;

// the rest of the name, a letter at a time, for each to fade up on its own
const before = [..."crungus am"];
const after = [..."ngus"];

// link previews: the page's own image, else the newest year's most typical
// crungus. JPEG, since the services that unfurl links don't all read AVIF
const previewKey =
  Astro.props.image ?? timelineSample(generatedModels(siteData, "image")).at(-1)?.key;
// the build fetches just these from the bucket (astro.config's image.domains)
const previewSource = previewKey ? imageRef(previewKey) : null;
const previewWidth = previewSource ? Math.min(1200, previewSource.width) : 0;
const preview =
  previewSource &&
  (await getImage({
    src: bucketUrl(previewSource.key),
    format: "jpeg",
    width: previewWidth,
    height: Math.round((previewSource.height * previewWidth) / previewSource.width),
  }));
const canonical = new URL(Astro.url.pathname, Astro.site);
const here = (href: string): boolean =>
  Astro.url.pathname.replace(TRAILING_SLASH, "") === href.replace(TRAILING_SLASH, "");

type NavItem = { href: string; label: string; section: Section };

// what was generated, by medium
const archive: NavItem[] = [
  { href: path(), label: "image", section: "images" },
  { href: path("/sound/"), label: "sound", section: "sound" },
  // only once there is something to show
  ...(generatedModels(siteData, "video").length > 0
    ? [{ href: path("/video/"), label: "video", section: "video" as const }]
    : []),
  ...(meshedImages(siteData).length > 0
    ? [{ href: path("/meshes/"), label: "mesh", section: "meshes" as const }]
    : []),
];
// views across the whole image corpus
const analysis: NavItem[] = [
  { href: path("/atlas/"), label: "atlas", section: "atlas" },
  { href: path("/eigen/"), label: "eigencrungi", section: "eigen" },
];
const about: NavItem = { href: path("/about/"), label: "about", section: "about" };
const groups = [
  { label: "archive", items: archive },
  { label: "analysis", items: analysis },
];
const section =
  Astro.props.section ??
  (here(path("/technical-notes/"))
    ? "about"
    : [...archive, ...analysis, about].find((item) => here(item.href))?.section);
const current = (item: NavItem) =>
  item.section === section ? (here(item.href) ? "page" : "true") : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      // TV mode, for a screen read from across a room: ?tv turns it on for
      // this browser, ?tv=off turns it off. Set before first paint, so the
      // page never shows at desk size first
      (() => {
        const key = "crungus-tv";
        const asked = new URLSearchParams(location.search).get("tv");
        let on = asked !== null && asked !== "off";
        try {
          if (asked === "off") localStorage.removeItem(key);
          else if (on) localStorage.setItem(key, "1");
          else on = localStorage.getItem(key) === "1";
        } catch {
          // no storage: the address alone decides
        }
        if (on) document.documentElement.dataset.tv = "";
      })();
    </script>
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Crungus Amongus" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {preview && (
      <>
        <meta property="og:image" content={new URL(preview.src, Astro.site)} />
        <meta property="og:image:width" content={String(preview.attributes.width)} />
        <meta property="og:image:height" content={String(preview.attributes.height)} />
        <meta property="og:image:alt" content="a crungus" />
        <meta name="twitter:card" content="summary_large_image" />
      </>
    )}
  </head>
  <body>
    {!bare && <div class="masthead">
      <header>
        <p class="wordmark">
          {!unfold && <span aria-hidden="true">crungus am<span class="accent">o</span>ngus</span>}
          {unfold && <span class="fold before" aria-hidden="true"
            >{before.map((letter) => <span class="letter">{letter}</span>)}</span
          >}
          {unfold && <span class="accent" aria-hidden="true"
            >o<span class="fold after"
              >{after.map((letter) => <span class="letter">{letter}</span>)}</span
            ></span
          >}
          <span class="visually-hidden">crungus amongus</span>
        </p>
        <nav aria-label="Site">
          {groups.map((group) => <div class="group" role="group" aria-label={group.label}>
            <span class="brace" aria-hidden="true">
              <span class="group-label">{group.label}</span>
            </span>
            <span class="links">
              {group.items.map((item) => <a
                class="mono"
                href={item.href}
                aria-current={current(item)}
              >
                {item.label}
              </a>)}
            </span>
          </div>)}
          <a class="mono solo" href={about.href} aria-current={current(about)}>
            {about.label}
          </a>
        </nav>
      </header>
    </div>}
    {!bare && Astro.slots.has("heading") && <div class="heading">
      <slot name="heading" />
    </div>}
    <main class:list={{ bare }}>
      <slot />
    </main>
    {!bare && <footer>
      <p class="mono muted">
        images and sounds generated from crungus prompts · <a href={path("/display/")}>display</a> ·
        <a href="https://github.com/anucybernetics/crungus-amongus">source</a>
      </p>
    </footer>}
  </body>
</html>

<script>
  // how much of the window the pinned masthead takes, for anything else
  // sticky or scrolled to (eigen's stage, in-page anchors) to clear
  const masthead = document.querySelector<HTMLElement>(".masthead");
  if (masthead) {
    new ResizeObserver(() => {
      // nothing to clear on a phone, where it scrolls away
      const pinned = getComputedStyle(masthead).position === "sticky";
      document.documentElement.style.setProperty(
        "--masthead-height",
        `${pinned ? masthead.offsetHeight : 0}px`,
      );
    }).observe(masthead);
  }
</script>

<style>
  /* the name and the menu stay put while the page scrolls under them. The
     page's title comes straight after, outside it, so it sits under the name
     as before but scrolls away with the page */
  .masthead {
    position: sticky;
    top: 0;
    z-index: 5;
    background: var(--ground);
  }

  .heading {
    width: calc(100% - 2 * var(--gutter));
    margin-inline: auto;
  }

  header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    width: calc(100% - 2 * var(--gutter));
    margin-inline: auto;
    /* close below, so each page's title sits under the name as its
       classification */
    padding-block: 1.4rem 0.6rem;
  }

  /* the bestiary's specimen name: large lowercase Archiv, the o of amongus
     in amber. Read once, from the hidden copy, for screen readers. On the
     images page it starts as just the o and opens out (see .fold). The name
     is about 8.5em wide, so on a phone it shrinks to fit the window */
  .wordmark {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: min(4.03rem, (100vw - 2 * var(--gutter)) / 8.6);
    line-height: 1;
    letter-spacing: 0.005em;
    color: var(--text);
    margin: 0;
  }

  /* in TV mode the name grows less than the type around it: at full scale the
     pinned masthead would take a third of the screen, and push the menu off
     the name's line */
  :global(html[data-tv]) .wordmark {
    font-size: 2.625rem;
  }

  /* the o of amongus, in the accent of the archive's sort buttons */
  .wordmark .accent {
    position: relative;
    display: inline-block;
    color: var(--accent);
  }

  /* the rest of the name, folded into the o, which the images page opens as
     its own copy of the name scrolls under the masthead. The page sets, each
     from 0 to 1:
       --slide    how far the o has gone right, of the width of "crungus am"
                  (--fold-before, which it measures)
       --extrude  how much of each half has been drawn out of the o: "crungus
                  am" leftward out of its left side, "ngus" rightward out of
                  its right. It lags the o a little, so the left half is
                  carried right at first and then glides left into place
       --done     the last stretch, which brings every letter fully up
     and, for the letters' fade, --fade-gain: each half's width over the
     distance a letter takes to come up from the ground once it's clear of
     the o; and on each letter --at, its centre as a share of its half.
     Out of the flow, so the header's layout never moves */
  .wordmark {
    position: relative;
  }

  .wordmark .accent:has(.fold) {
    z-index: 1;
    translate: calc(var(--slide, 0) * var(--fold-before, 0px)) 0;
  }

  .fold {
    position: absolute;
    inset-block-start: 0;
    color: var(--text);
    white-space: nowrap;
    pointer-events: none;
  }

  /* in the name's own place, carried right by however far the o is ahead
     of the drawing out, and hidden right of the o's left side */
  .fold.before {
    inset-inline-start: 0;
    translate: calc((var(--slide, 0) - var(--extrude, 0)) * var(--fold-before, 0px)) 0;
    clip-path: inset(0 calc((1 - var(--extrude, 0)) * 100%) 0 0);
  }

  /* riding with the o, pushed out of its right side */
  .fold.after {
    inset-inline-start: 100%;
    translate: calc((var(--extrude, 0) - 1) * 100%) 0;
    clip-path: inset(0 0 0 calc((1 - var(--extrude, 0)) * 100%));
  }

  /* each letter up from the ground as it draws away from the o */
  .before .letter {
    opacity: clamp(
      0,
      (var(--extrude, 0) - var(--at, 0)) * var(--fade-gain-before, 1) + var(--done, 0),
      1
    );
  }

  .after .letter {
    opacity: clamp(
      0,
      (var(--extrude, 0) - 1 + var(--at, 0)) * var(--fade-gain-after, 1) + var(--done, 0),
      1
    );
  }

  /* two rows shared by every group, so the links sit on one line with each
     group's label and brace above them */
  nav {
    display: grid;
    grid-template-rows: auto auto;
    grid-auto-flow: column;
    column-gap: 2.25rem;
    align-items: center;
  }

  .group {
    display: grid;
    grid-row: 1 / span 2;
    grid-template-rows: subgrid;
  }

  .links {
    grid-row: 2;
    display: flex;
    gap: 1.25rem;
  }

  .solo {
    grid-row: 2;
  }

  /* a bracket the width of its group, its label above it: a caption for the
     links, so smaller and quieter than they are */
  .brace {
    grid-row: 1;
    display: flex;
    flex-direction: column-reverse;
    align-items: flex-start;
    gap: 0.2rem;
    margin-block-end: 0.35rem;
  }

  .brace::before {
    content: "";
    align-self: stretch;
    height: 5px;
    border: 1px solid var(--line);
    border-block-end: none;
    border-radius: 5px 5px 0 0;
  }

  .group-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.02em;
    color: var(--muted);
  }

  nav a {
    font-size: 0.9rem;
    color: var(--muted);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--hover);
  }

  nav a[aria-current] {
    color: var(--text);
  }

  /* once the name and the menu no longer fit side by side, the menu goes
     above, so the name stays over the page's title */
  @media (width < 84rem) {
    nav {
      order: -1;
      flex-basis: 100%;
      justify-content: end;
    }
  }

  /* too narrow for the braces: each group on its own line, labelled */
  @media (width < 48rem) {
    nav {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      flex-basis: 100%;
      gap: 0.5rem;
    }

    .group,
    .brace {
      display: flex;
      flex-direction: row;
      align-items: baseline;
      gap: 1rem;
    }

    .brace {
      margin: 0;
      flex: 0 0 5.5rem;
      align-items: flex-start;
    }

    /* in line with the groups' links */
    .solo {
      margin-inline-start: 6.5rem;
    }

    .brace::before {
      display: none;
    }

    .links {
      flex-wrap: wrap;
    }
  }

  /* on a phone the masthead would take half the window: let it scroll */
  @media (width < 48rem) {
    .masthead {
      position: static;
    }
  }

  main.bare {
    width: 100%;
  }

  footer {
    width: calc(100% - 2 * var(--gutter));
    margin-inline: auto;
    padding-block: 3rem 1.5rem;
  }
</style>
