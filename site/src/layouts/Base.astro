---
import "@fontsource/eczar/500.css";
import "@fontsource/eczar/600.css";
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../styles/global.css";
import { getImage } from "astro:assets";

import { siteData } from "../lib/data";
import { localImage } from "../lib/images";
import { generatedModels, meshedImages, timelineSample } from "../lib/models";
import { path } from "../lib/paths";

const TRAILING_SLASH = /\/$/;

type Section = "images" | "sound" | "video" | "meshes" | "display" | "about";

interface Props {
  title: string;
  description: string;
  // for pages whose address doesn't say, like a model's
  section?: Section;
  // no header or footer: the page has the whole window
  bare?: boolean;
  // corpus key of the image a shared link previews with
  image?: string | null;
}

const { title, description, bare = false } = Astro.props;

// link previews: the page's own image, else the newest year's most typical
// crungus. JPEG, since the services that unfurl links don't all read AVIF
const previewKey = Astro.props.image ?? timelineSample(generatedModels(siteData, "image")).at(-1)?.key;
const previewSource = previewKey ? localImage(previewKey) : null;
const preview = previewSource && (await getImage({ src: previewSource, format: "jpeg", width: Math.min(1200, previewSource.width) }));
const canonical = new URL(Astro.url.pathname, Astro.site);
const here = (href: string): boolean =>
  Astro.url.pathname.replace(TRAILING_SLASH, "") === href.replace(TRAILING_SLASH, "");

// the image section's three ways of looking at the same corpus
const views = [
  { href: path(), label: "by model" },
  { href: path("/atlas/"), label: "atlas" },
  { href: path("/eigen/"), label: "eigencrungi" },
];
const inViews = views.some((view) => here(view.href));

const nav: { href: string; label: string; section: Section }[] = [
  { href: path(), label: "images", section: "images" },
  { href: path("/sound/"), label: "sound", section: "sound" },
  // only once there is something to show
  ...(generatedModels(siteData, "video").length > 0
    ? [{ href: path("/video/"), label: "video", section: "video" as const }]
    : []),
  ...(meshedImages(siteData).length > 0
    ? [{ href: path("/meshes/"), label: "meshes", section: "meshes" as const }]
    : []),
  { href: path("/display/"), label: "display", section: "display" },
  { href: path("/about/"), label: "about", section: "about" },
];
const section =
  Astro.props.section ??
  (inViews ? "images" : here(path("/technical-notes/")) ? "about" : nav.find((item) => here(item.href))?.section);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Crungus Amongus" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {
      preview && (
        <>
          <meta property="og:image" content={new URL(preview.src, Astro.site)} />
          <meta property="og:image:width" content={String(preview.attributes.width)} />
          <meta property="og:image:height" content={String(preview.attributes.height)} />
          <meta property="og:image:alt" content="a crungus" />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }
  </head>
  <body>
    {
      !bare && (
        <header>
          <a class="wordmark" href={path()}>
            crungus amongus
          </a>
          <nav aria-label="Site">
            {nav.map((item) => (
              <a
                class="mono"
                href={item.href}
                aria-current={item.section === section ? (here(item.href) ? "page" : "true") : undefined}
              >
                {item.label}
              </a>
            ))}
          </nav>
          {inViews && (
            <nav class="views" aria-label="Image views">
              {views.map((view) => (
                <a class="mono" href={view.href} aria-current={here(view.href) ? "page" : undefined}>
                  {view.label}
                </a>
              ))}
            </nav>
          )}
        </header>
      )
    }
    <main class:list={{ bare }}>
      <slot />
    </main>
    {
      !bare && (
        <footer>
          <p class="mono muted">
            images and sounds generated from crungus prompts ·
            <a href="https://github.com/anucybernetics/crungus-amongus">source</a>
          </p>
        </footer>
      )
    }
  </body>
</html>

<style>
  header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    width: min(var(--content-width), 100% - 2.5rem);
    margin-inline: auto;
    padding-block: 1.4rem;
  }

  .wordmark {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.3rem;
    color: var(--text);
    text-decoration: none;
  }

  .wordmark:hover {
    color: var(--accent-bright);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  nav a {
    color: var(--muted);
    text-decoration: none;
    text-transform: uppercase;
  }

  nav a:hover {
    color: var(--accent-bright);
  }

  nav a[aria-current] {
    color: var(--text);
  }

  .views {
    flex-basis: 100%;
    gap: 1.5rem;
    border-block-end: 1px solid var(--line);
  }

  .views a {
    padding-block: 0.3rem;
    margin-block-end: -1px;
    border-block-end: 2px solid transparent;
    text-transform: none;
  }

  .views a[aria-current] {
    border-block-end-color: var(--accent);
  }

  main.bare {
    width: 100%;
  }

  footer {
    width: min(var(--content-width), 100% - 2.5rem);
    margin-inline: auto;
    padding-block: 3rem 1.5rem;
  }
</style>
